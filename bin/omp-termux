#!/usr/bin/env bash
# omp-termux — install and update the @oh-my-pi/pi-natives N-API addon for omp on Android aarch64 / Termux.
#
#   omp-termux install [version|file]   bring this device to that version: no argument = the version it runs,
#                                       "latest" = the newest build published here, or a local .node
#   omp-termux status                   show the installed pi-natives package(s)
#   omp-termux verify                   check that the addon loads and omp starts
#   omp-termux doctor                   check the environment of this device
#   omp-termux update-self              replace this tool with the newest from this repository
#   omp-termux uninstall-self           remove the tool and its self-update cache from this device
#
# Environment: OMP_TERMUX_REPO, OMP_TERMUX_RELEASE_BASE and OMP_TERMUX_RAW_BASE (point the tool at another
# repository), OMP_TERMUX_CACHE_HOME (the scratch directory; default: the XDG cache dir plus /omp-termux),
# OMP_TERMUX_VERSION (the version an argument-less install targets), OMP_TERMUX_NO_UPDATE_CHECK (any value =
# never check for a newer omp-termux; status then reads its `newest here` line from the cache),
# OMP_TERMUX_UPDATE_TTL (seconds between checks, default 86400).
# Design notes: docs/topic/tool.md.
set -Eeuo pipefail
# An unexpected non-zero (usually a pipeline element under `pipefail`) would abort with no message.
trap 'printf "\033[1;31m[error]\033[0m unexpected failure at %s:%s: %s\n" "${BASH_SOURCE[0]##*/}" "$LINENO" "$BASH_COMMAND" >&2' ERR

TERMUX_PREFIX="${PREFIX:-}"             # Termux exports PREFIX; capture it before this script reuses the name
PREFIX="$HOME/.local/opt/omp-termux"    # this tool's own copy, not XDG_DATA_HOME: every install it made is here
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ADDON="pi_natives.android-arm64.node"
VERIFY_LOG="verify.log"
PROBE_JS="probe.mjs"
UPSTREAM_REPO="can1357/oh-my-pi"        # upstream project: its newest release has no build here until we build one
REPO="${OMP_TERMUX_REPO:-hmeqo/omp-termux}"
TOOL_VERSION=0.5.2                      # a label only: every comparison reads the content hash
PROG="omp-termux"                        # names this script in hints; dev/omp-termux-dev overrides it
PARENT_PATH="$PATH"                      # inherited before use_root prepends to ours: the PATH hints judge the user's shell
SELF_URL="${OMP_TERMUX_RAW_BASE:-https://raw.githubusercontent.com/$REPO/main}/bin/omp-termux"
SELF_CACHE="$PREFIX/cache/self-update"  # under $PREFIX, so uninstall-self removes it too
SELF_TTL="${OMP_TERMUX_UPDATE_TTL:-86400}"
case "$SELF_TTL" in '' | *[!0-9]*) SELF_TTL=86400 ;; esac

# --- reporting and small helpers ------------------------------------------------------------------
msg()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }

warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }

die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

# like msg, but on stderr: a hint never changes what a verb writes to stdout
hint() { printf '\033[1;36m==>\033[0m %s\n' "$*" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

json_version() {
	[ -f "${1:-}" ] || return 0
	sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -n1
}

file_sha() { [ -f "${1:-}" ] || return 0; sha256sum "$1" 2>/dev/null | cut -d' ' -f1 || true; }

tmp_dir() { # a directory this process may write scratch files to; "" when there is none
	# $TMPDIR is often unset (install.sh, CI, cron), so /tmp comes last.
	local d
	for d in "${TMPDIR:-}" "$HOME" /tmp; do
		if [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ]; then
			printf '%s\n' "$d"
			return 0
		fi
	done
	return 0
}

scratch_files() { # every file this tool may leave under $CACHE_HOME
	printf '%s\n' "$ADDON" "$ADDON.part" "$VERIFY_LOG" "$PROBE_JS"
}

scratch_clear() { # remove only what this tool wrote under $CACHE_HOME, then the directory when empty
	local f
	[ -n "${CACHE_HOME:-}" ] || return 0
	case "$CACHE_HOME" in
		/ | "$HOME" | "$HOME"/) warn "refusing to clear $CACHE_HOME"; return 0 ;;
	esac
	while IFS= read -r f; do
		rm -f "$CACHE_HOME/$f" 2>/dev/null || warn "left $CACHE_HOME/$f behind"
	done < <(scratch_files)
	rmdir "$CACHE_HOME" 2>/dev/null || true
}

panel_line() { printf '==> %-17s : %s\n' "$1" "$2"; }

version_max() { printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1; }

version_min() { printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1; }

version_ge() { [ "$1" = "$(version_max "$1" "$2")" ]; }

version_gt() { [ "$1" != "$2" ] && version_ge "$1" "$2"; }

version_lt() { [ "$1" != "$2" ] && [ "$1" = "$(version_min "$1" "$2")" ]; }

same_path() { # $1, $2 = paths: true when they reach the same directory (a symlinked spelling included)
	[ "$(readlink -f "${1:-/nonexistent}" 2>/dev/null)" = "$(readlink -f "${2:-/nonexistent}" 2>/dev/null)" ]
}

usage() { sed -n '4,10p' "$SELF" | sed 's/^# \{0,1\}//'; }

reject_option() { # $1 = the argument to check; option-looking arguments are always a mistake here
	case "${1:-}" in
		-*) die "unexpected option: $1 (run '$PROG help')" ;;
	esac
}

require_file_arg() { # $1 = an argument that names a file; dies when it does not
	[ -f "$1" ] || die "not a file: $1"
}

# --- environment: bun, omp and this tool's own directories ----------------------------------------
# resolve_env sets these once; a step that changes the environment calls it again.

BIN_HOME=""      # where omp-termux is linked, on PATH
CACHE_HOME=""    # scratch: downloads, probes and logs; removed after every run
TMP_HOME=""      # a writable temp dir for this process
BUN_DEFAULT=""   # bun's own default root: where a bun this tool installs lands
BUN_ROOTS=""     # the install roots that exist, one per line
BUN_HOME=""      # the root in use
BUN_BIN=""       # "" when bun is missing
OMP_BIN=""       # "" when there is none

absolute_dir() { # $1 = a path from the environment; prints it when it is absolute (usable), nothing otherwise
	# bun fails with EACCES on a relative root; the XDG spec wants absolute paths too.
	case "${1:-}" in
		/*) printf '%s\n' "$1" ;;
	esac
}

bun_default_root() { # bun's own rule: BUN_INSTALL wins, XDG_CACHE_HOME moves the default, else ~/.bun
	local r
	r="$(absolute_dir "${BUN_INSTALL:-}")"
	if [ -n "$r" ]; then
		printf '%s\n' "$r"
		return 0
	fi
	r="$(absolute_dir "${XDG_CACHE_HOME:-}")"
	if [ -n "$r" ]; then
		printf '%s\n' "$r/.bun"
		return 0
	fi
	printf '%s\n' "$HOME/.bun"
}

existing_bun_roots() { # the rule: every install root that exists, bun's own rule order first
	local r seen=""
	# $HOME/.cache/.bun is bun's XDG-era root, reachable only through XDG_CACHE_HOME, so it comes last.
	for r in "${BUN_INSTALL:-}" "${XDG_CACHE_HOME:+$XDG_CACHE_HOME/.bun}" "$HOME/.bun" "$HOME/.cache/.bun"; do
		case "$r" in ""|/*) ;; *) continue ;; esac   # a relative root is not one bun can use (see absolute_dir)
		case " $seen " in *" $r "*) continue ;; esac
		[ -d "$r/install" ] || continue
		seen="$seen $r"
		printf '%s\n' "$r"
	done
}

bun_roots() { # the install roots this run resolved, one per line (resolve_env re-reads them)
	if [ -n "$BUN_ROOTS" ]; then
		printf '%s\n' "$BUN_ROOTS"
	fi
}

bun_root_in_use() { # the root in use: one that already carries omp, else any existing, else the default
	local r
	while IFS= read -r r; do
		[ -f "$r/install/global/node_modules/@oh-my-pi/pi-coding-agent/package.json" ] &&
			{ printf '%s\n' "$r"; return 0; }
	done < <(bun_roots)
	while IFS= read -r r; do printf '%s\n' "$r"; return 0; done < <(bun_roots)
	printf '%s\n' "$BUN_DEFAULT"
}

bin_home_dir() { # where this tool links itself: Termux' $PREFIX/bin is already on PATH, XDG_BIN_HOME is the rest
	local b
	if [ -n "$TERMUX_PREFIX" ]; then
		printf '%s\n' "$TERMUX_PREFIX/bin"
		return 0
	fi
	b="$(absolute_dir "${XDG_BIN_HOME:-}")"
	[ -n "$b" ] || b="$HOME/.local/bin"
	printf '%s\n' "$b"
}

cache_home_dir() { # scratch: $OMP_TERMUX_CACHE_HOME, else the XDG cache dir, else ~/.cache
	local d
	d="$(absolute_dir "${OMP_TERMUX_CACHE_HOME:-}")"
	case "$d" in
		/ | "$HOME" | "$HOME"/) warn "ignoring OMP_TERMUX_CACHE_HOME=$d: not a scratch directory"; d="" ;;
	esac
	if [ -z "$d" ]; then
		d="$(absolute_dir "${XDG_CACHE_HOME:-}")"
		[ -n "$d" ] || d="$HOME/.cache"
		d="$d/omp-termux"
	fi
	printf '%s\n' "$d"
}

bun_binary_path() { # "" when bun is not installed
	local b r
	b="$(command -v bun 2>/dev/null || true)"
	# a PATH hit can be a stale hash entry or a noexec mount: fall through to the install roots then
	[ -n "$b" ] && [ -x "$b" ] || b=""
	if [ -z "$b" ]; then
		r="$BUN_DEFAULT"
		[ -x "$r/bin/bun" ] && b="$r/bin/bun"
		if [ -z "$b" ]; then
			while IFS= read -r r; do
				[ -x "$r/bin/bun" ] && { b="$r/bin/bun"; break; }
			done < <(bun_roots)
		fi
	fi
	if [ -n "$b" ] && [ -x "$b" ]; then
		printf '%s\n' "$b"
	fi
}

omp_binary_path() { # the `omp` the user runs: PATH first, then the roots (a non-interactive shell has neither)
	local b r
	b="$(command -v omp 2>/dev/null || true)"
	[ -n "$b" ] && [ -x "$b" ] && { printf '%s\n' "$b"; return 0; }
	while IFS= read -r r; do
		[ -x "$r/bin/omp" ] && { printf '%s\n' "$r/bin/omp"; return 0; }
	done < <(bun_roots)
	return 0
}

resolve_env() { # the one place the environment is read; call it again after a step that changes it
	BIN_HOME="$(bin_home_dir)"
	CACHE_HOME="$(cache_home_dir)"
	TMP_HOME="$(tmp_dir)"
	BUN_DEFAULT="$(bun_default_root)"
	BUN_ROOTS="$(existing_bun_roots)"
	BUN_HOME="$(bun_root_in_use)"     # reads $BUN_ROOTS and $BUN_DEFAULT, so those are set first
	BUN_BIN="$(bun_binary_path)"
	OMP_BIN="$(omp_binary_path)"
}
# resolve_env runs from main, not here: sourcing this file (dev/omp-termux-dev) must not probe the machine.

# Pin this shell, and anything it spawns, at the root in use: bun installs where BUN_INSTALL points,
# not where PATH does.
use_root() {
	BUN_INSTALL="$BUN_HOME"; export BUN_INSTALL
	case ":$PATH:" in
		*":$BUN_HOME/bin:"*) ;;
		*) PATH="$BUN_HOME/bin:$PATH"; export PATH ;;
	esac
}

# The same rule as a POSIX snippet for the device; tests/verify.sh compares both answers.
REMOTE_ROOT_PROBE='r=""; for c in "$BUN_INSTALL" "${XDG_CACHE_HOME:+"$XDG_CACHE_HOME/.bun"}" "$HOME/.bun" "$HOME/.cache/.bun"; do case "$c" in ""|/*) ;; *) continue ;; esac; [ -d "$c/install" ] || continue; [ -z "$r" ] && r="$c"; [ -f "$c/install/global/node_modules/@oh-my-pi/pi-coding-agent/package.json" ] && { r="$c"; break; }; done; if [ -z "$r" ]; then r=""; case "$BUN_INSTALL" in /*) r="$BUN_INSTALL" ;; esac; if [ -z "$r" ]; then case "$XDG_CACHE_HOME" in /*) r="$XDG_CACHE_HOME/.bun" ;; esac; fi; [ -n "$r" ] || r="$HOME/.bun"; fi'

# --- what is installed: the pi-natives directories ------------------------------------------------
search_roots() { # every directory that may hold an installed @oh-my-pi/pi-natives
	local r
	while IFS= read -r r; do
		printf '%s\n' "$r/install/cache" "$r/install/global/node_modules"
	done < <(bun_roots)
	npm_roots
}

npm_roots() { # npm's global trees; they live outside every bun root
	printf '%s\n' "${TERMUX_PREFIX:-/nonexistent}/lib/node_modules" "${NPM_CONFIG_PREFIX:-/nonexistent}/lib/node_modules"
}

# Every installed package, once, under the spelling it was found as.
natives_dirs() {
	local root d real seen=$'\n'
	while IFS= read -r root; do
		[ -d "$root" ] || continue
		while IFS= read -r d; do
			[ -f "$d/package.json" ] || continue
			real="$(readlink -f "$d" 2>/dev/null)" || real="$d"
			[ -n "$real" ] || real="$d"
			case "$seen" in *$'\n'"$real"$'\n'*) continue ;; esac
			seen="$seen$real"$'\n'
			printf '%s\n' "$d"
		done < <(find -L "$root" -maxdepth 3 -type d -path '*@oh-my-pi/pi-natives*' 2>/dev/null)
	done < <(search_roots) | sort -u
}

newest_natives_dir() { # $1 = a root prefix; prints the newest matching dir
	local d v best="" dir=""
	while IFS= read -r d; do
		case "$d" in "$1"/*) ;; *) continue ;; esac
		v="$(json_version "$d/package.json")"
		[ -n "$v" ] || continue
		if [ -z "$best" ] || version_ge "$v" "$best"; then
			best="$v"
			dir="$d"
		fi
	done < <(natives_dirs)
	printf '%s\n' "$dir"
}

installed_state() { # the pi-natives this device loads: sets CUR_VERSION, CUR_ADDON, CUR_DIR, CUR_CLI_VERSION
	# the running omp resolves the root in use's global tree; a pi-natives in another root is a leftover
	local root dir scope cli npm
	root="$BUN_HOME"
	scope="$root/install/global/node_modules/@oh-my-pi"
	dir="$scope/pi-natives"
	[ -f "$dir/package.json" ] || dir="$(newest_natives_dir "$root")"
	if [ -z "$dir" ]; then
		while IFS= read -r npm; do
			dir="$(newest_natives_dir "$npm")"
			if [ -n "$dir" ]; then
				break
			fi
		done < <(npm_roots)
	fi
	CUR_VERSION=""
	CUR_ADDON=""
	CUR_DIR=""
	if [ -n "$dir" ] && [ -f "$dir/package.json" ]; then
		CUR_VERSION="$(json_version "$dir/package.json")"
		CUR_ADDON="$dir/native/$ADDON"
		CUR_DIR="$dir"
	fi
	# The omp can be another release than the pi-natives its tree holds; the "ahead" guard asks about it.
	CUR_CLI_VERSION=""
	cli="$scope/pi-coding-agent/package.json"
	if [ -f "$cli" ]; then
		CUR_CLI_VERSION="$(json_version "$cli")"
	fi
}

installed_version() { # the version the root in use carries
	installed_state
	printf '%s\n' "$CUR_VERSION"
}

# The loader skips its release check when the native dir has no /node_modules/ segment.
is_workspace_load() {
	case "$1" in
		*/node_modules/*) return 1 ;;
		*) return 0 ;;
	esac
}

# A stamped addon reports PI_NATIVES_VERSION_STAMP:<version>; older releases export __piNativesV<version>.
artifact_version() { # $1 = .node file -> the release it reports ("" when it carries no identity)
	local stamp
	stamp="$(grep -ao 'PI_NATIVES_VERSION_STAMP:[-0-9A-Za-z._]*' "${1:-}" 2>/dev/null | head -n1)" || true
	if [ -n "$stamp" ]; then
		printf '%s\n' "${stamp#PI_NATIVES_VERSION_STAMP:}"
		return 0
	fi
	grep -ao '__piNativesV[0-9A-Za-z_]*' "${1:-}" 2>/dev/null | head -n1 | sed 's/^__piNativesV//; s/_/./g' || true
}

# --- this tool's own install and update -----------------------------------------------------------
path_hint() { # $1 = a directory the user has to reach; says so once, in the running shell's syntax
	case ":$PARENT_PATH:" in
		*":$1:"*) return 0 ;;
	esac
	printf '\n' >&2
	hint "$1 is not in your PATH yet. Add it, e.g."
	case "${SHELL:-}" in
		*/fish) printf '  fish_add_path %s\n' "$1" >&2 ;;
		*) printf '  export PATH="%s:$PATH"    # add to ~/.bashrc, ~/.zshrc, ...\n' "$1" >&2 ;;
	esac
}

path_reminder() { # what a device install leaves behind that this shell cannot reach yet: `omp` and the tool
	# bun's bin dir is named only when something to run actually sits in it.
	if [ "$BUN_HOME/bin" != "$BIN_HOME" ] && { [ -x "$BUN_HOME/bin/omp" ] || [ -x "$BUN_HOME/bin/bun" ]; }; then
		path_hint "$BUN_HOME/bin"
	fi
	path_hint "$BIN_HOME"
}

link_self() { # $PREFIX/bin/omp-termux linked into $BIN_HOME; quiet while the link is already right
	local target="$BIN_HOME/omp-termux" want="$PREFIX/bin/omp-termux"
	if [ -d "$target" ] && [ ! -L "$target" ]; then
		# `ln -sfn` into a directory links inside it instead; leave a real directory alone.
		warn "not linking $target: it is a directory, not a link"
		return 0
	fi
	if [ "$(readlink "$target" 2>/dev/null)" = "$want" ]; then
		path_reminder   # the link is right, but $BIN_HOME may still be missing from PATH
		return 0
	fi
	mkdir -p "$BIN_HOME"
	ln -sfn "$want" "$target"
	msg "linked $target -> $want"
	path_reminder
}

tool_label() { printf 'v%s (%s)' "$TOOL_VERSION" "$(file_sha "$SELF" | cut -c1-12)"; }

cmd_install_self() { # keep this tool on PATH: $PREFIX, linked into $BIN_HOME
	mkdir -p "$PREFIX/bin"
	# Running the installed copy is the normal case on a device: copying it onto itself would fail.
	[ "$SELF" = "$PREFIX/bin/omp-termux" ] || install -m 0755 "$SELF" "$PREFIX/bin/omp-termux"
	link_self
}

cmd_uninstall_self() {
	msg "removing $BIN_HOME/omp-termux and $PREFIX"
	rm -f "$BIN_HOME/omp-termux"
	rm -rf "$PREFIX"
	rmdir "$(dirname "$PREFIX")" 2>/dev/null || true   # leave no empty ~/.local/opt behind
}

cache_get() { sed -n "s/^$1=//p" "$SELF_CACHE" 2>/dev/null | head -n1 || true; }

cache_put() { # $1 = key, $2 = value; one key per line in $SELF_CACHE, rewritten in place
	# the cache is an optimization: a failed write must not fail the verb
	local tmp="$SELF_CACHE.$$"
	mkdir -p "$(dirname "$SELF_CACHE")"
	if { grep -v "^$1=" "$SELF_CACHE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } >"$tmp" && mv -f "$tmp" "$SELF_CACHE"; then
		return 0
	fi
	rm -f "$tmp"
	return 0
}

record_release() { # $1 = the newest build published here ("" when unknown), $2 = timestamp (default: now)
	cache_put release_checked_at "${2:-$(date +%s)}"
	if [ -n "$1" ]; then
		cache_put release "$1"
	fi
}

refresh_release_cache() { # the `newest here` fact: its own timestamp, the shared $SELF_TTL
	local now at vrel
	now="$(date +%s)"
	at="$(cache_get release_checked_at)"
	case "$at" in '' | *[!0-9]*) at="" ;; esac
	if [ -n "$at" ] && [ "$((now - at))" -lt "$SELF_TTL" ]; then
		return 0
	fi
	vrel="$(latest_release_version)"
	record_release "$vrel" "$now"
	return 0
}

self_fetch() { # $1 = etag ("" for a plain GET), $2 = header file, $3 = body file, $4 = code file
	if [ -n "$1" ]; then
		curl -fsS --max-time 20 -D "$2" -o "$3" -w '%{http_code}' -H "If-None-Match: $1" "$SELF_URL" >"$4" 2>/dev/null
	else
		curl -fsS --max-time 20 -D "$2" -o "$3" -w '%{http_code}' "$SELF_URL" >"$4" 2>/dev/null
	fi
}

fetch_file() { # $1 = output, $2 = URL, $3 = max seconds (default 300)
	curl -fsSL --retry 3 --connect-timeout 15 --max-time "${3:-300}" -o "$1" "$2"
}

update_checks_on() { # 0 when this copy should reach the network: the installed one, and no opt-out
	[ -z "${OMP_TERMUX_NO_UPDATE_CHECK:-}" ] && [ "$SELF" = "$PREFIX/bin/omp-termux" ]
}

check_self_update() { # one line on stderr when main holds a different copy; never fails the verb
	update_checks_on || return 0
	local now at etag code hdr body codef tmp remote cur vremote
	now="$(date +%s)"
	tmp="$TMP_HOME"
	[ -n "$tmp" ] || return 0
	hdr="$tmp/omp-termux.hdr.$$"
	body="$tmp/omp-termux.new.$$"
	codef="$tmp/omp-termux.code.$$"
	cur="$(file_sha "$SELF")"
	# The cached remote hash is only comparable to the copy that fetched it.
	at="$(cache_get checked_at)"
	case "$at" in '' | *[!0-9]*) at="" ;; esac
	[ "$(cache_get self)" = "$cur" ] || at=""
	if [ -z "$at" ] || [ "$((now - at))" -ge "$SELF_TTL" ]; then
		etag="$(cache_get etag)"
		# the exit status is the gate (a partial or 4xx transfer fails there); the code only picks out 304
		if self_fetch "$etag" "$hdr" "$body" "$codef"; then
			code="$(cat "$codef" 2>/dev/null || true)"
			cache_put checked_at "$now"
			cache_put self "$cur"
			if [ "$code" != 304 ]; then
				cache_put etag "$(sed -n 's/^[Ee]tag: //p' "$hdr" | head -n1 | tr -d '\r')"
				cache_put hash "$(file_sha "$body")"
				cache_put version "$(sed -n 's/^TOOL_VERSION=\([^[:space:]]*\).*/\1/p' "$body" | head -n1)"
			fi
		else
			# offline or broken endpoint: record the attempt, or every verb pays another timeout
			cache_put checked_at "$now"
			cache_put self "$cur"
		fi
	fi
	rm -f "$hdr" "$body" "$codef"
	refresh_release_cache
	remote="$(cache_get hash)"
	[ -n "$remote" ] || return 0
	[ "$remote" = "$cur" ] && return 0
	vremote="$(cache_get version)"
	[ -n "$vremote" ] || vremote=main
	hint "omp-termux update available: v$TOOL_VERSION (${cur:0:12}) -> v$vremote (${remote:0:12}); run 'omp-termux update-self'"
}

cmd_update_self() {
	local tmp old new
	tmp="$PREFIX/bin/omp-termux.new.$$"
	mkdir -p "$PREFIX/bin"
	msg "fetching $SELF_URL"
	fetch_file "$tmp" "$SELF_URL" || { rm -f "$tmp"; die "cannot fetch $SELF_URL"; }
	if ! bash -n "$tmp" 2>/dev/null; then
		rm -f "$tmp"
		die "the downloaded script is not valid shell; kept the installed copy"
	fi
	old="$(file_sha "$PREFIX/bin/omp-termux")"
	new="$(file_sha "$tmp")"
	if [ -n "$old" ] && [ "$old" = "$new" ]; then
		rm -f "$tmp"
		msg "already up to date (${new:0:12})"
		return 0
	fi
	mv -f "$tmp" "$PREFIX/bin/omp-termux"
	chmod 0755 "$PREFIX/bin/omp-termux"
	rm -f "$SELF_CACHE"     # the next check must re-fetch, not compare against the replaced copy's hash
	msg "updated ${old:0:12} -> ${new:0:12}"
	link_self
}

# --- install: on the device -----------------------------------------------------------------------
stray_scope_deps() { # the @oh-my-pi entries the global manifest lists besides the CLI, space separated
	# bun resolves a leftover entry to the newest version its range allows, over the CLI's exact pins.
	local manifest="$BUN_HOME/install/global/package.json" strays="" name
	[ -f "$manifest" ] || return 0
	while IFS= read -r name; do
		strays="${strays:+$strays }$name"
	done < <(tr ',' '\n' <"$manifest" |
		sed -n 's/^[[:space:]]*"\(@oh-my-pi\/[^"]*\)"[[:space:]]*:.*/\1/p' |
		grep -v '^@oh-my-pi/pi-coding-agent$' || true)
	printf '%s\n' "$strays"
}

drop_stray_scope_deps() { # removes the scope entries bun kept besides the CLI, where the verb is about to act
	# Never on the way to a refusal: a run that changes nothing must leave the manifest alone too.
	local strays
	[ -n "$BUN_BIN" ] || return 0
	strays="$(stray_scope_deps)"
	[ -n "$strays" ] || return 0
	use_root
	msg "dropping the stale global entries: $strays"
	for name in $strays; do
		# One per call: a batched remove fails wholesale when any name is absent, leaving the rest in place.
		"$BUN_BIN" remove -g "$name" || warn "removing $name from the global manifest failed"
	done
}

install_addon() { # $1 = path to a .node
	local addon="$1" target_version="" n=0 seen="" d v
	[ -f "$addon" ] || die "no artifact to install: $addon"
	# What the artifact reports is what the loader checks, so it decides the target version.
	target_version="$(artifact_version "$addon")"
	[ -n "$target_version" ] && msg "target version from the artifact: $target_version"
	while IFS= read -r d; do
		v="$(json_version "$d/package.json")"
		if [ -n "$target_version" ] && [ "$v" != "$target_version" ]; then
			# The loader compares that release against the package, so another version must not receive it.
			seen="${seen:+$seen, }${v:-unknown}"
			continue
		fi
		mkdir -p "$d/native"
		# .part then rename: a killed copy must not leave a truncated file under the name the loader reads.
		cp -f "$addon" "$d/native/$ADDON.part" || die "cannot stage $ADDON under $d/native"
		mv -f "$d/native/$ADDON.part" "$d/native/$ADDON"
		msg "installed -> $d/native/$ADDON$(is_workspace_load "$d" && echo ' [workspace-load: release check skipped]' || echo ' [node_modules: release must match]')"
		n=$((n + 1))
	done < <(natives_dirs)
	[ "$n" -gt 0 ] || die "no @oh-my-pi/pi-natives for ${target_version:-the artifact} on this device${seen:+ (found: $seen)}; 'omp-termux install latest' provisions omp here"
}

link_global_tree() { # bun's cache layout has no node_modules for a lazily imported package; link the global
	# tree in. `ln -sfn` into a directory would link inside it, so a real directory is left alone.
	local root cache global entry name
	while IFS= read -r root; do
		cache="$root/install/cache"
		global="$root/install/global/node_modules"
		[ -d "$cache" ] && [ -d "$global" ] || continue
		mkdir -p "$cache/node_modules"
		for entry in "$global"/*; do
			[ -e "$entry" ] || continue
			name="$(basename "$entry")"
			if [ -L "$cache/node_modules/$name" ]; then
				ln -sfn "$entry" "$cache/node_modules/$name"
			elif [ -d "$cache/node_modules/$name" ]; then
				# `ln -sfn` into an existing directory creates a link *inside* it; leave the directory alone.
				warn "not linking $name: $cache/node_modules/$name is a directory, not a link"
			elif [ ! -e "$cache/node_modules/$name" ]; then
				ln -s "$entry" "$cache/node_modules/$name"
			fi
		done
	done < <(bun_roots)
}

has_other_link_ref() { # $1 = candidate dir, $2 = bun's own nested sibling link (ignored)
	local want ignore root l
	want="$(readlink -f "$1" 2>/dev/null)"
	[ -n "$want" ] || return 1
	ignore="$(readlink -f "${2:-/nonexistent}" 2>/dev/null)"
	while IFS= read -r root; do
		while IFS= read -r l; do
			[ "$l" = "${2:-}" ] && continue
			[ -n "$ignore" ] && [ "$l" = "$ignore" ] && continue
			[ "$(readlink -f "$l" 2>/dev/null)" = "$want" ] && return 0
		done < <(find "$root/install" -maxdepth 6 -type l 2>/dev/null)
	done < <(bun_roots)
	return 1
}

prune_superseded() { # $1 = the version now installed; drops older pi-natives copies from bun's cache
	# cache only, strictly older, never through a symlink (`find` without -L).
	local keep="${1:-}" root cache d v sz base stem nested
	[ -n "$keep" ] || return 0
	while IFS= read -r root; do
		cache="$root/install/cache"
		[ -d "$cache" ] || continue
		while IFS= read -r d; do
			v="$(json_version "$d/package.json")"
			[ -n "$v" ] && version_lt "$v" "$keep" || continue
			base="$(basename "$d")"
			stem="${base%@@@1}"
			nested="$(dirname "$d")/${stem%@*}/${stem#*@}@@@1"
			if has_other_link_ref "$d" "$nested"; then
				warn "keeping the $v copy: a link still points at it"
				continue
			fi
			sz="$(du -sh "$d" 2>/dev/null | cut -f1)"
			[ -L "$nested" ] && rm -f "$nested"
			rm -rf "$d" && msg "removed the superseded $v copy${sz:+ ($sz)}"
		done < <(find "$cache" -maxdepth 3 -type d -path '*@oh-my-pi/pi-natives*' 2>/dev/null)
	done < <(bun_roots)
	return 0
}

download_bun() { # $1 = root to install into (default: $BUN_DEFAULT)
	local root="${1:-$BUN_DEFAULT}" tmp
	tmp="${TMP_HOME:-$HOME}/omp-bun.$$"
	mkdir -p "$tmp" "$root/bin" || return 1
	fetch_file "$tmp/bun.zip" \
		https://github.com/oven-sh/bun/releases/latest/download/bun-linux-aarch64-android.zip || { rm -rf "$tmp"; return 1; }
	unzip -oq "$tmp/bun.zip" -d "$tmp" || { rm -rf "$tmp"; return 1; }
	cp -f "$tmp"/bun-linux-aarch64-android/bun "$root/bin/bun" || { rm -rf "$tmp"; return 1; }
	chmod +x "$root/bin/bun"
	rm -rf "$tmp"
	resolve_env
	use_root
	BUN_BIN="$root/bin/bun"   # the build just fetched, even when another root also has a stale bun
	[ -x "$BUN_BIN" ]
}

device_ensure_bun() { # install bun on this device when it is missing
	[ -n "$BUN_BIN" ] && return 0
	msg "installing bun"
	if have pkg && pkg install -y bun >/dev/null 2>&1; then
		resolve_env      # pkg just provided a bun: read it before deciding there is none
		if [ -n "$BUN_BIN" ]; then
			use_root
			return 0
		fi
	fi
	download_bun
}

upgrade_bun() { # bring the bun in use to the newest build; its own upgrader first, then the Android zip
	local out=""
	if [ -n "$BUN_BIN" ] && out="$("$BUN_BIN" upgrade 2>&1)"; then
		resolve_env
		use_root
		return 0
	fi
	[ -n "$out" ] && warn "bun upgrade failed: $(printf '%s\n' "$out" | tail -n1)"
	msg "fetching the latest bun Android build"
	download_bun "$BUN_HOME"
}

cli_bun_floor() { # the "engines.bun" floor of the omp this device runs, if declared
	local real pkg req
	[ -n "$OMP_BIN" ] || return 0
	real="$(readlink -f "$OMP_BIN" 2>/dev/null)" || return 0
	pkg="$(dirname "$(dirname "$real")")/package.json"
	[ -f "$pkg" ] || return 0
	req="$(sed -n '/"engines"/,/}/s/.*"bun": *"[^0-9]*\([0-9][0-9.]*\).*/\1/p' "$pkg" | sed -n 1p)"
	[ -n "$req" ] || return 0
	printf '%s\n' "$req"
}

ensure_bun_for_omp() { # 0 when the bun in use satisfies the omp on this device; upgrades it otherwise
	# An omp that needs a newer bun cannot start, so bun is raised before the addon is installed.
	local need cur
	need="$(cli_bun_floor)"
	[ -n "$need" ] || return 0
	[ -n "$BUN_BIN" ] || device_ensure_bun || return 1
	cur="$("$BUN_BIN" --version 2>/dev/null || true)"
	[ -n "$cur" ] || { warn "cannot read the bun version"; return 1; }
	version_lt "$cur" "$need" || return 0
	msg "omp requires bun >= $need (found $cur); upgrading bun"
	upgrade_bun || { warn "bun upgrade failed; run 'bun upgrade' on this device"; return 1; }
	cur="$("$BUN_BIN" --version 2>/dev/null || true)"
	if [ -n "$cur" ] && ! version_lt "$cur" "$need"; then
		return 0
	fi
	warn "bun is ${cur:-unknown}, but omp needs >= $need"
	return 1
}

fetch_release() { # $1 = pi-natives version; puts the addon in RELEASE_ADDON, dies when the release is missing
	local version="$1" base reported
	base="${OMP_TERMUX_RELEASE_BASE:-https://github.com/$REPO/releases/download/omp-$version}"
	msg "fetching pi-natives $version for android-arm64"
	mkdir -p "$CACHE_HOME"
	# .part then rename: curl fails a length mismatch, so a partial file never takes the addon's name
	fetch_file "$CACHE_HOME/$ADDON.part" "$base/$ADDON" || {
		scratch_clear
		die "no release for $version at $base; nothing was changed"
	}
	mv -f "$CACHE_HOME/$ADDON.part" "$CACHE_HOME/$ADDON"
	reported="$(artifact_version "$CACHE_HOME/$ADDON")"
	if [ "$reported" != "$version" ]; then
		scratch_clear
		die "the downloaded addon is $([ -n "$reported" ] && echo "for $reported, not $version" || echo "not a pi-natives build"); nothing was changed"
	fi
	RELEASE_ADDON="$CACHE_HOME/$ADDON"
}

device_resolve_target() { # $1 = install argument, $2 = newest build published here; sets WANT, UP, EXPLICIT
	case "$1" in
		"")
			WANT="${OMP_TERMUX_VERSION:-$CUR_VERSION}"
			if [ -z "$WANT" ]; then
				[ -n "$2" ] || die "no omp on this device and no published build to install (network?); pass one: omp-termux install <version>"
				WANT="$2"
				msg "no omp on this device yet — installing $WANT (the newest build published here)"
			fi
			;;
		latest)
			if [ -z "$2" ]; then
				[ -n "$CUR_VERSION" ] ||
					die "cannot resolve the newest build published here (network?); nothing was changed"
				warn "cannot resolve the newest build published here (network?); keeping omp-$CUR_VERSION"
			fi
			WANT="${2:-$CUR_VERSION}"
			if [ -n "$2" ]; then
				UP="$(latest_version)"
			fi
			;;
		*) EXPLICIT=1; WANT="${1#v}" ;;
	esac
}

device_is_current() { # $1 = target version; 0 when the addon is in place, omp exists, and it loads
	local vlog="$CACHE_HOME/$VERIFY_LOG"
	mkdir -p "$CACHE_HOME"
	: >"$vlog"
	# run_verify dies on a failed load, so it runs in a subshell; its output matters only when it fails
	if [ "$CUR_VERSION" = "$1" ] && [ -f "$CUR_ADDON" ] && [ -n "$OMP_BIN" ] && ( run_verify ) >"$vlog" 2>&1; then
		rm -f "$vlog"
		return 0
	fi
	if [ -s "$vlog" ]; then
		warn "the installed addon does not load; reinstalling it"
	fi
	rm -f "$vlog"
	return 1
}

ensure_device_omp() { # $1 = version; leaves RELEASE_ADDON
	local want="$1" current pin
	# Fetch before moving omp: an upgrade without the matching addon in hand leaves omp unable to start.
	device_ensure_bun || die "cannot install bun; install it by hand: pkg install bun"
	fetch_release "$want"
	drop_stray_scope_deps
	current="$CUR_VERSION"
	if [ "$CUR_CLI_VERSION" != "$want" ] || [ "$current" != "$want" ] || [ -z "$OMP_BIN" ]; then
		use_root
		[ -n "$BUN_BIN" ] || die "bun not found; install it first: pkg install bun"
		if [ -z "$OMP_BIN" ] && [ -z "$CUR_CLI_VERSION" ] && [ -z "$current" ]; then
			msg "installing omp $want on this device (currently none)"
		elif [ -z "$OMP_BIN" ]; then
			msg "the global tree has no bin/omp; reinstalling omp $want on this device"
		elif [ "$CUR_CLI_VERSION" != "$want" ]; then
			msg "installing omp $want on this device (currently ${CUR_CLI_VERSION:-none})"
		else
			msg "the global tree resolves ${current:-none}; bringing it back to $want"
		fi
		# Name the addon package while the tree is off target; the pin is taken back out below.
		pin=""
		[ "$current" != "$want" ] && pin=" @oh-my-pi/pi-natives@$want"
		"$BUN_BIN" install -g "@oh-my-pi/pi-coding-agent@$want"$pin || die "installing omp $want failed"
		if [ -n "$pin" ]; then
			"$BUN_BIN" remove -g "@oh-my-pi/pi-natives" || warn "the natives pin could not be taken back out"
		fi
		resolve_env      # bun's global tree changed: read the roots again before touching the addon
	fi
	if ! ensure_bun_for_omp; then
		scratch_clear
		die "bun is older than omp $want requires; run 'bun upgrade' on this device"
	fi
}

device_install() { # $1 = version, "latest", or a path to a .node; no argument = the version this device runs
	local arg="${1:-}" WANT="" PUB="" UP="" EXPLICIT=""
	link_global_tree
	if [ -f "$arg" ]; then
		ensure_bun_for_omp ||
			die "bun is older than the omp on this device requires; run 'bun upgrade'"
		install_addon "$arg"
		cmd_install_self
		return 0
	fi
	case "$arg" in
		*/* | *.node) require_file_arg "$arg" ;;
	esac
	installed_state
	# a device can only be brought to a version this repository published
	PUB="$(latest_release_version)"
	if [ -n "$PUB" ]; then
		record_release "$PUB"
	fi
	device_resolve_target "$arg" "$PUB"
	if [ -n "$PUB" ]; then
		panel_line "newest build here" "omp-$PUB"
	fi
	if [ -n "$UP" ] && version_gt "$UP" "$WANT"; then
		msg "upstream $UP is published but has no build here yet"
	fi
	if device_is_current "$WANT"; then
		drop_stray_scope_deps
		panel_line "you have" "omp-$CUR_VERSION (addon in place, loads OK)"
		scratch_clear
		cmd_install_self
		msg "nothing to do"
		return 0
	fi
	panel_line "you have" "omp-${CUR_VERSION:-none}$([ -n "$CUR_VERSION" ] && [ ! -f "$CUR_ADDON" ] && echo ' (addon missing)')"
	# what is published bounds the targets the tool picks itself; a named version is the caller's call
	if [ -z "$EXPLICIT" ] && [ -n "$CUR_CLI_VERSION" ] && [ -n "$PUB" ] && version_gt "$CUR_CLI_VERSION" "$PUB"; then
		die "no build published here for the omp you run: $CUR_CLI_VERSION (newest: omp-$PUB); nothing was changed
        wait for that build, or step back: bun install -g @oh-my-pi/pi-coding-agent@$PUB"
	fi
	ensure_device_omp "$WANT"
	install_addon "$RELEASE_ADDON"
	scratch_clear
	run_verify
	prune_superseded "$WANT"
	cmd_install_self
}

run_verify() { # load the addon through the real loader, then smoke-test the CLI
	# this verb only runs on the device, so the probe lives in the scratch dir it already owns
	local probe_dir="$CACHE_HOME" probe d rc=0
	[ -n "$(natives_dirs)" ] || die "no @oh-my-pi/pi-natives on this machine; nothing to verify"
	probe="$probe_dir/$PROBE_JS"
	mkdir -p "$probe_dir"
	cat >"$probe" <<'EOF'
const target = process.argv[2]
const mod = await import(target)
const required = ["countTokens", "visibleWidth", "grep", "Shell", "PtySession", "TtyWriter", "EditSession"]
const missing = required.filter(n => mod[n] === undefined)
const absent = ["DesktopSession", "copyToClipboard", "AudioCapture"].filter(n => mod[n] === undefined)
console.log(`  runtime ${process.platform}-${process.arch}: ${Object.keys(mod).length} exports, ${required.length - missing.length}/${required.length} core exports`)
if (absent.length) console.log(`  platform-trimmed modules (expected on Android): ${absent.join(", ")}`)
if (missing.length) { console.error("  missing:", missing.join(", ")); process.exit(1) }
console.log("  NATIVE LOAD OK")
EOF
	# The verdict hangs on the copy omp resolves; leftovers need no addon for this platform.
	installed_state
	while IFS= read -r d; do
		msg "loading through the loader: $d"
		[ -n "$BUN_BIN" ] || { warn "bun not found (looked for 'bun' on PATH and under $BUN_DEFAULT); cannot load-test $d"; rc=1; continue; }
		"$BUN_BIN" "$probe" "$d/native/index.js" || {
			if [ -n "$CUR_DIR" ] && ! same_path "$d" "$CUR_DIR"; then
				warn "load failed (not the pi-natives this device loads): $d"
			else
				warn "load failed: $d"
				rc=1
			fi
		}
	done < <(natives_dirs)
	rm -f "$probe"
	rmdir "$probe_dir" 2>/dev/null || true
	# `omp` is whatever the user installed; a copy outside the root in use is reported.
	if [ -n "$OMP_BIN" ]; then
		msg "$OMP_BIN --version"
		"$OMP_BIN" --version || { warn "omp still fails to start"; rc=1; }
		case "$OMP_BIN" in
			"$BUN_HOME"/bin/omp) ;;
			*) warn "$OMP_BIN is not the copy in use ($BUN_HOME/bin/omp)" ;;
		esac
	else
		warn "no omp binary found (PATH and $BUN_HOME/bin); cannot smoke-test the CLI"
		rc=1
	fi
	[ "$rc" -eq 0 ] || die "verification failed"
	msg "all good"
}

# --- status ---------------------------------------------------------------------------------------
print_status() {
	local d v f rel
	if update_checks_on; then
		refresh_release_cache
	fi
	printf 'tool       : %s\n' "$SELF"
	printf 'version    : %s\n' "$(tool_label)"
	rel="$(cache_get release)"
	[ -n "$rel" ] && printf 'newest here: omp-%s\n' "$rel"
	printf 'omp binary : %s\n' "${OMP_BIN:-not found}"
	printf '\n'
	while IFS= read -r d; do
		v="$(json_version "$d/package.json")"
		f="$d/native/$ADDON"
		printf '%s\n  version=%s  addon=%s%s\n' "$d" "$v" \
			"$([ -f "$f" ] && echo "$(du -h "$f" | cut -f1) $(date -r "$f" '+%F %T')" || echo missing)" \
			"$(is_workspace_load "$d" && echo '  [workspace-load]' || echo '  [node_modules: release enforced]')"
	done < <(natives_dirs)
}

# --- version lookups ------------------------------------------------------------------------------

github_latest_tag() { # $1 = owner/repo, $2 = tag prefix to strip; "" when the lookup fails
	# the redirect costs no quota, unlike api.github.com (60 requests per hour per IP, shared on mobile NAT)
	curl -sSI --max-time 20 "https://github.com/$1/releases/latest" 2>/dev/null |
		sed -n "s|^[Ll]ocation:.*/releases/tag/$2\([^[:space:]]*\).*|\1|p" | head -n1 || true
}

latest_version() { github_latest_tag "$UPSTREAM_REPO" v; }           # newest upstream omp release

latest_release_version() { github_latest_tag "$REPO" 'omp-'; }       # newest release this repository publishes


# --- doctor ---------------------------------------------------------------------------------------
device_doctor() {
	local natives
	msg "environment check (device)"
	# A non-login shell (how install.sh invokes the tool) may have PREFIX but no TERMUX_VERSION.
	printf '  Termux         : %s\n' "${TERMUX_VERSION:-${TERMUX_PREFIX:-not detected}}"
	printf '  uname          : %s %s\n' "$(uname -s)" "$(uname -m)"
	printf '  tool           : %s\n' "$SELF"
	printf '  omp-termux     : %s\n' "$(tool_label)"
	printf '  bun            : %s\n' "${BUN_BIN:-MISSING}"
	printf '  omp binary     : %s\n' "${OMP_BIN:-not found}"
	natives="$(installed_version)"
	printf '  pi-natives     : %s\n' "${natives:-not found}"
	printf '  free space     : %s\n' "$(df -h "$HOME" 2>/dev/null | awk 'NR==2{print $4}')"
	[ -n "$BUN_BIN" ] || warn "bun is missing: 'omp-termux install latest' installs it together with omp"
}


# --- dispatch -----------------------------------------------------------------------------------------

main() {
	local verb="${1:-help}" arg=""
	case "$verb" in
		help | -h | --help)
			[ "$#" -le 1 ] || die "unexpected argument: $2"
			usage
			return 0
			;;
		install)
			shift
			reject_option "${1:-}"
			[ "$#" -le 1 ] || die "unexpected argument: $2"
			arg="${1:-}"
			;;
		status | verify | doctor | update-self | uninstall-self)
			reject_option "${2:-}"
			[ "$#" -le 1 ] || die "unexpected argument: $2"
			;;
		*)
			warn "unknown verb: $verb"
			usage
			exit 1
			;;
	esac
	resolve_env
	[ "$verb" = update-self ] || check_self_update || true
	case "$verb" in
		install) device_install "$arg" ;;
		status) print_status ;;
		verify) run_verify ;;
		doctor) device_doctor ;;
		update-self) cmd_update_self ;;
		uninstall-self) cmd_uninstall_self ;;
	esac
}

# dev/omp-termux-dev sources this file for $ADDON, $UPSTREAM_REPO and the helpers both halves use;
# only an executed copy runs a verb (an `if`, not `[ ] &&`: sourcing must not report failure under `set -e`).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	main "$@"
fi
