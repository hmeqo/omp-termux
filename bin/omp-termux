#!/usr/bin/env bash
# omp-termux — install and manage the @oh-my-pi/pi-natives N-API addon for omp on Android aarch64 / Termux.
#
#   omp-termux install [version|file]   workstation: bring the device to that version (build, upload, install,
#                                       verify); device: the same for itself — no argument = the version it runs,
#                                       "latest" = newest build published here, or install a local .node
#   omp-termux status                   show the installed pi-natives package(s)
#   omp-termux verify                   check that the addon loads
#   omp-termux build [version]          only produce the addon, without touching the device
#   omp-termux device [user@host]       show or save the device target (~/.config/omp-termux/config)
#   omp-termux doctor                   check the toolchain (workstation) or the environment (device)
#   omp-termux install-self             put this tool on PATH (~/.local/opt/omp-termux)
#   omp-termux uninstall-self           remove it
#   omp-termux update-self              replace the installed copy with the newest from this repository
#
# Environment: OMP_TERMUX_HOST (user@host), OMP_TERMUX_PORT (8022), OMP_TERMUX_NDK (explicit NDK path;
# otherwise ANDROID_NDK_ROOT / ANDROID_NDK_HOME / the SDK's newest ndk/* is used),
# OMP_TERMUX_NO_UPDATE_CHECK (any value = never check for a newer omp-termux), OMP_TERMUX_UPDATE_TTL
# (seconds between checks, default 86400).
# Layout: bin/omp-termux (this file), out/ (artifacts), work/ (clone, cargo target, caches; gitignored).
set -Eeuo pipefail
# An unexpected non-zero (usually a pipeline element under `pipefail`) would otherwise abort with no
# message at all; name the line and the command instead.
trap 'printf "\033[1;31m[error]\033[0m unexpected failure at %s:%s: %s\n" "${BASH_SOURCE[0]##*/}" "$LINENO" "$BASH_COMMAND" >&2' ERR

TERMUX_PREFIX="${PREFIX:-}"             # Termux exports PREFIX; capture it before this script reuses the name
PREFIX="$HOME/.local/opt/omp-termux"
BINDIR="$HOME/.local/bin"
[ -n "$TERMUX_PREFIX" ] && BINDIR="$TERMUX_PREFIX/bin"   # Termux: that dir is already on PATH
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PROJ="$(dirname "$SELF_DIR")"          # this file lives in <project>/bin/
SCRATCH=".cache/omp-termux"             # scratch dir on the device; removed after every run
WORK="$PROJ/work"
OUT="$PROJ/out"
SRC="$WORK/src"
NAPI_CLI_DIR="$WORK/napi-cli"
OPUS_PREFIX="$WORK/opus-24-arm64"
CARGO_TARGET="${CARGO_TARGET_DIR:-$WORK/cargo-target}"
ADDON="pi_natives.android-arm64.node"
API=24
UPSTREAM="https://github.com/can1357/oh-my-pi.git"
UPSTREAM_REPO="${UPSTREAM#https://github.com/}"    # owner/repo, for the release and patch URLs
UPSTREAM_REPO="${UPSTREAM_REPO%.git}"
PR=6350
PR_PATCH_URL="https://patch-diff.githubusercontent.com/raw/$UPSTREAM_REPO/pull/${PR}.diff"
REPO="${OMP_TERMUX_REPO:-hmeqo/omp-termux}"
TOOL_VERSION=0.1.0                      # a label only: every comparison reads the content hash
SELF_URL="${OMP_TERMUX_RAW_BASE:-https://raw.githubusercontent.com/$REPO/main}/bin/omp-termux"
SELF_CACHE="$PREFIX/cache/self-update"  # under $PREFIX, so uninstall-self removes it too
SELF_TTL="${OMP_TERMUX_UPDATE_TTL:-86400}"
case "$SELF_TTL" in '' | *[!0-9]*) SELF_TTL=86400 ;; esac

if [ -n "${TERMUX_VERSION:-}" ] || [ -d /data/data/com.termux/files/usr ]; then
	MODE="${OMP_TERMUX_MODE:-device}"
else
	MODE="${OMP_TERMUX_MODE:-workstation}"
fi

# Optional saved target: `omp-termux device user@host` writes this file; the environment wins over it.
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/omp-termux/config"
cfg_get() { [ -f "$CFG" ] || return 0; sed -n "s/^$1=//p" "$CFG" | head -n1 | tr -d '"'; }
CFG_HOST="$(cfg_get OMP_TERMUX_HOST)"
CFG_PORT="$(cfg_get OMP_TERMUX_PORT)"

msg()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }
# like msg, but on stderr: a hint never changes what a verb writes to stdout
hint() { printf '\033[1;36m==>\033[0m %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
# The NDK is the system's business: use whatever the SDK, a package manager or the
# environment already provides instead of shipping a private copy.
detect_ndk() {
	local c root
	for c in "${OMP_TERMUX_NDK:-}" "${ANDROID_NDK_ROOT:-}" "${ANDROID_NDK_HOME:-}" "${ANDROID_NDK_LATEST_HOME:-}"; do
		[ -n "$c" ] && [ -d "$c/toolchains/llvm/prebuilt" ] && { printf '%s\n' "${c%/}"; return 0; }
	done
	for root in "${ANDROID_HOME:-}" "$HOME/Android/Sdk" "$HOME/.local/share/Android/Sdk" /opt/android-sdk; do
		[ -n "$root" ] && [ -d "$root/ndk" ] || continue
		c="$(ls -d "$root"/ndk/*/ 2>/dev/null | sort -V | tail -n1)"
		[ -n "$c" ] && { printf '%s\n' "${c%/}"; return 0; }
	done
	for c in /opt/android-ndk "$HOME/.local/share/android-ndk"; do
		[ -d "$c/toolchains/llvm/prebuilt" ] && { printf '%s\n' "$c"; return 0; }
	done
	return 1
}
NDK="$(detect_ndk || true)"
ndk_ok() { [ -n "$NDK" ] && [ -d "$NDK/toolchains/llvm/prebuilt/linux-x86_64" ]; }
device_host() { printf '%s' "${OMP_TERMUX_HOST:-${CFG_HOST:-}}"; }

path_reminder() {
	case ":$PATH:" in
		*":$BINDIR:"*) return 0 ;;
	esac
	echo
	warn "$BINDIR is not in your PATH yet. Add it, e.g."
	case "${SHELL:-}" in
		*/fish) printf '  fish_add_path %s\n' "$BINDIR" ;;
		*) printf '  export PATH="%s:$PATH"    # add to ~/.bashrc, ~/.zshrc, ...\n' "$BINDIR" ;;
	esac
}
device_port() { # explicit setting > what ssh itself resolves for this host > Termux' default 8022
	local p host
	p="${OMP_TERMUX_PORT:-${CFG_PORT:-}}"
	if [ -n "$p" ]; then
		printf '%s' "$p"
		return 0
	fi
	host="$(device_host)"
	if [ -n "$host" ]; then
		# `ssh -G` reports the port ssh would use, including ~/.ssh/config. 22 means the config says
		# nothing about this host, which is not a Termux port, so fall back to 8022 in that case.
		p="$(ssh -G "$host" 2>/dev/null | sed -n 's/^port //p' | head -n1)"
		if [ -n "$p" ] && [ "$p" != 22 ]; then
			printf '%s' "$p"
			return 0
		fi
	fi
	printf '8022'
}

usage() { sed -n '4,14p' "$SELF" | sed 's/^# \{0,1\}//'; }
reject_option() { # $1 = the argument to check; option-looking arguments are always a mistake here
	case "${1:-}" in
		-*) die "unexpected option: $1 (run 'omp-termux help')" ;;
	esac
}

vendored_patch() {
	local candidate
	for candidate in "$PROJ"/patches/*.patch "$SELF_DIR"/patches/*.patch "$PREFIX"/patches/*.patch; do
		[ -f "$candidate" ] || continue
		# stale after a PR bump: only a file naming the current PR may be applied
		grep -q "/pull/$PR" "$candidate" 2>/dev/null || continue
		printf '%s\n' "$candidate"; return 0
	done
	return 1
}
PATCH="$(vendored_patch || printf '%s' "$WORK/upstream-${PR}.diff")"

github_latest_tag() { # $1 = owner/repo, $2 = tag prefix to strip; "" when the lookup fails
	# the redirect costs no quota, unlike api.github.com (60 requests per hour per IP, shared on mobile NAT)
	curl -sSI --max-time 20 "https://github.com/$1/releases/latest" 2>/dev/null |
		sed -n "s|^[Ll]ocation:.*/releases/tag/$2\([^[:space:]]*\).*|\1|p" | head -n1 || true
}

latest_version() { github_latest_tag "$UPSTREAM_REPO" v; }           # newest upstream omp release
latest_release_version() { github_latest_tag "$REPO" 'omp-'; }       # newest release this repository publishes

resolve_latest() { # sets LATEST to the newest upstream release, or dies
	LATEST="$(latest_version)"
	[ -n "$LATEST" ] || die "cannot resolve the latest upstream release; pass one: omp-termux install <version>"
	msg "latest upstream release: $LATEST"
}

# --- inspecting the installed addon ------------------------------------------------------------------

json_version() {
	[ -f "${1:-}" ] || return 0
	sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -n1
}

bun_root() { # bun's own rule: BUN_INSTALL wins, XDG_CACHE_HOME moves the default, else ~/.bun
	if [ -n "${BUN_INSTALL:-}" ]; then
		printf '%s\n' "$BUN_INSTALL"
	elif [ -n "${XDG_CACHE_HOME:-}" ]; then
		printf '%s\n' "$XDG_CACHE_HOME/.bun"
	else
		printf '%s\n' "$HOME/.bun"
	fi
}

bun_roots() { # every install root present, in the order this tool reads the environment (see probe below)
	local r seen=""
	for r in "${BUN_INSTALL:-}" "${XDG_CACHE_HOME:+$XDG_CACHE_HOME/.bun}" "$HOME/.cache/.bun" "$HOME/.bun"; do
		[ -n "$r" ] || continue
		case " $seen " in *" $r "*) continue ;; esac
		[ -d "$r/install" ] || continue
		seen="$seen $r"
		printf '%s\n' "$r"
	done
}

# --- environment resolution -------------------------------------------------------------------------

bun_active_root() { # the root in use: one that already carries omp, else any existing, else the default
	local r
	while IFS= read -r r; do
		[ -f "$r/install/global/node_modules/@oh-my-pi/pi-coding-agent/package.json" ] &&
			{ printf '%s\n' "$r"; return 0; }
	done < <(bun_roots)
	while IFS= read -r r; do printf '%s\n' "$r"; return 0; done < <(bun_roots)
	bun_root
}

# Pin this shell, and anything it spawns, at the root in use: bun installs where BUN_INSTALL points,
# not where PATH does.
use_root() {
	local r
	r="$(bun_active_root)"
	BUN_INSTALL="$r"; export BUN_INSTALL
	case ":$PATH:" in
		*":$r/bin:"*) ;;
		*) PATH="$r/bin:$PATH"; export PATH ;;
	esac
}

# The same rule as a POSIX snippet the device evaluates itself (see bun_active_root).
REMOTE_ROOT_PROBE='r=""; for c in "$BUN_INSTALL" "$XDG_CACHE_HOME/.bun" "$HOME/.cache/.bun" "$HOME/.bun"; do [ -n "$c" ] && [ -d "$c/install" ] || continue; [ -z "$r" ] && r="$c"; [ -f "$c/install/global/node_modules/@oh-my-pi/pi-coding-agent/package.json" ] && { r="$c"; break; }; done; if [ -z "$r" ]; then if [ -n "$XDG_CACHE_HOME" ]; then r="$XDG_CACHE_HOME/.bun"; else r="$HOME/.bun"; fi; fi'

remote_bun_root() { # a snippet that prints the device's root in use
	printf '%s; printf "%%s" "$r"' "$REMOTE_ROOT_PROBE"
}

# Every command the tool runs on the device goes through this: it pins BUN_INSTALL so bun installs into
# the root in use rather than its own default.
remote_bun_env() { # a snippet that runs a device command inside the root in use
	printf '%s; BUN_INSTALL="$r"; export BUN_INSTALL; PATH="$r/bin:$PATH"; export PATH' "$REMOTE_ROOT_PROBE"
}

search_roots() { # every directory that may hold an installed @oh-my-pi/pi-natives
	local r
	while IFS= read -r r; do
		printf '%s\n' "$r/install/cache" "$r/install/global/node_modules"
	done < <(bun_roots)
	printf '%s\n' "${TERMUX_PREFIX:-/nonexistent}/lib/node_modules" "${NPM_CONFIG_PREFIX:-/nonexistent}/lib/node_modules"
}

# Every installed @oh-my-pi/pi-natives directory: bun cache (both layouts), bun global, npm global.
natives_dirs() {
	local root d
	while IFS= read -r root; do
		[ -d "$root" ] || continue
		while IFS= read -r d; do
			[ -f "$d/package.json" ] && printf '%s\n' "$d"
		done < <(find -L "$root" -maxdepth 3 -type d -path '*@oh-my-pi/pi-natives*' 2>/dev/null)
	done < <(search_roots) | sort -u
}

newest_natives_dir() { # $1 = a root prefix, or "" for every root; prints the newest matching dir
	local d v best="" dir=""
	while IFS= read -r d; do
		if [ -n "${1:-}" ]; then
			case "$d" in "$1"/*) ;; *) continue ;; esac
		fi
		v="$(json_version "$d/package.json")"
		[ -n "$v" ] || continue
		if [ -z "$best" ] || [ "$(printf '%s\n%s\n' "$v" "$best" | sort -V | tail -n1)" = "$v" ]; then
			best="$v"
			dir="$d"
		fi
	done < <(natives_dirs)
	printf '%s\n' "$dir"
}

installed_state() { # the pi-natives this device loads: sets CUR_VERSION and CUR_ADDON
	# the running omp resolves the root in use's global tree; a pi-natives in another root is a leftover
	local root dir
	root="$(bun_active_root)"
	dir="$root/install/global/node_modules/@oh-my-pi/pi-natives"
	[ -f "$dir/package.json" ] || dir="$(newest_natives_dir "$root")"
	[ -n "$dir" ] || dir="$(newest_natives_dir)"
	CUR_VERSION=""
	CUR_ADDON=""
	if [ -n "$dir" ] && [ -f "$dir/package.json" ]; then
		CUR_VERSION="$(json_version "$dir/package.json")"
		CUR_ADDON="$dir/native/$ADDON"
	fi
}

installed_version() { # the version the root in use carries
	installed_state
	printf '%s\n' "$CUR_VERSION"
}

version_gt() { [ "$1" != "$2" ] && [ "$1" = "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" ]; }

panel_line() { printf '==> %-17s : %s\n' "$1" "$2"; }

bun_path() { # "" when bun is not installed
	local b r
	b="$(command -v bun 2>/dev/null || true)"
	# a PATH hit can be a stale hash entry or a noexec mount: fall through to the install roots then
	[ -n "$b" ] && [ -x "$b" ] || b=""
	if [ -z "$b" ]; then
		r="$(bun_root)"
		[ -x "$r/bin/bun" ] && b="$r/bin/bun"
		if [ -z "$b" ]; then
			while IFS= read -r r; do
				[ -x "$r/bin/bun" ] && { b="$r/bin/bun"; break; }
			done < <(bun_roots)
		fi
	fi
	if [ -n "$b" ] && [ -x "$b" ]; then
		printf '%s\n' "$b"
	fi
}

omp_path() { # the `omp` the user runs: PATH first, then the roots (a non-interactive shell has neither)
	local b r
	b="$(command -v omp 2>/dev/null || true)"
	[ -n "$b" ] && [ -x "$b" ] && { printf '%s\n' "$b"; return 0; }
	while IFS= read -r r; do
		[ -x "$r/bin/omp" ] && { printf '%s\n' "$r/bin/omp"; return 0; }
	done < <(bun_roots)
	return 0
}

file_sha() { [ -f "${1:-}" ] || return 0; sha256sum "$1" 2>/dev/null | cut -d' ' -f1 || true; }

tmp_dir() { # a directory this process may write scratch files to; "" when there is none
	# $TMPDIR is unset in the non-login shells the tool often runs in (ssh, install.sh), and the fallbacks
	# the rest of the tool uses are the home directory; /tmp only ever comes last.
	local d
	for d in "${TMPDIR:-}" "$HOME" /tmp; do
		if [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ]; then
			printf '%s\n' "$d"
			return 0
		fi
	done
	return 0
}

# --- this tool's own update check ---------------------------------------------------------------------

cache_get() { sed -n "s/^$1=//p" "$SELF_CACHE" 2>/dev/null | head -n1 || true; }

cache_put() { # $1 = key, $2 = value; one key per line in $SELF_CACHE, rewritten in place
	# the cache is an optimization: a failed write must not fail the verb
	local tmp="$SELF_CACHE.$$"
	mkdir -p "$(dirname "$SELF_CACHE")"
	if { grep -v "^$1=" "$SELF_CACHE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } >"$tmp" && mv -f "$tmp" "$SELF_CACHE"; then
		return 0
	fi
	rm -f "$tmp"
	return 0
}

self_fetch() { # $1 = etag ("" for a plain GET), $2 = header file, $3 = body file, $4 = code file
	if [ -n "$1" ]; then
		curl -fsS --max-time 20 -D "$2" -o "$3" -w '%{http_code}' -H "If-None-Match: $1" "$SELF_URL" >"$4" 2>/dev/null
	else
		curl -fsS --max-time 20 -D "$2" -o "$3" -w '%{http_code}' "$SELF_URL" >"$4" 2>/dev/null
	fi
}

check_self_update() { # one line on stderr when main holds a different copy; never fails the verb
	[ -n "${OMP_TERMUX_NO_UPDATE_CHECK:-}" ] && return 0
	[ "$SELF" = "$PREFIX/bin/omp-termux" ] || return 0   # a checkout or the install.sh copy is not the installed one
	local now at etag code hdr body codef tmp remote cur vrel vremote
	now="$(date +%s)"
	tmp="$(tmp_dir)"
	[ -n "$tmp" ] || return 0
	hdr="$tmp/omp-termux.hdr.$$"
	body="$tmp/omp-termux.new.$$"
	codef="$tmp/omp-termux.code.$$"
	at="$(cache_get checked_at)"
	if [ -z "$at" ] || [ "$((now - at))" -ge "$SELF_TTL" ]; then
		etag="$(cache_get etag)"
		# the exit status is the gate (a partial or 4xx transfer fails there); the code only picks out 304
		if self_fetch "$etag" "$hdr" "$body" "$codef"; then
			code="$(cat "$codef" 2>/dev/null || true)"
			cache_put checked_at "$now"
			if [ "$code" != 304 ]; then
				cache_put etag "$(sed -n 's/^[Ee]tag: //p' "$hdr" | head -n1 | tr -d '\r')"
				cache_put hash "$(file_sha "$body")"
				cache_put version "$(sed -n 's/^TOOL_VERSION=\([^[:space:]]*\).*/\1/p' "$body" | head -n1)"
			fi
		else
			# offline or broken endpoint: record the attempt, or every verb pays another timeout
			cache_put checked_at "$now"
		fi
	fi
	rm -f "$hdr" "$body" "$codef"
	# status reads its "newest here" line from $SELF_CACHE, so refresh that fact on the same TTL
	at="$(cache_get release_checked_at)"
	if [ -z "$at" ] || [ "$((now - at))" -ge "$SELF_TTL" ]; then
		vrel="$(latest_release_version)"
		cache_put release_checked_at "$now"
		[ -n "$vrel" ] && cache_put release "$vrel"
	fi
	remote="$(cache_get hash)"
	[ -n "$remote" ] || return 0
	cur="$(file_sha "$SELF")"
	[ "$remote" = "$cur" ] && return 0
	vremote="$(cache_get version)"
	[ -n "$vremote" ] || vremote=main
	hint "omp-termux update available: v$TOOL_VERSION (${cur:0:12}) -> v$vremote (${remote:0:12}); run 'omp-termux update-self'"
}

# The loader skips its version-sentinel check when the native dir has no /node_modules/ segment.
is_workspace_load() {
	case "$1" in
		*/node_modules/*) return 1 ;;
		*) return 0 ;;
	esac
}

artifact_version() { # $1 = .node file -> version from its embedded sentinel ("" when unreadable)
	grep -ao '__piNativesV[0-9A-Za-z_]*' "${1:-}" 2>/dev/null | head -n1 | sed 's/^__piNativesV//; s/_/./g' || true
}

# Copies the patched adapter next to the addon: on Android the addon exports no DesktopSession, and the
# package entrypoint calls adaptDesktopSession() at load time.
copy_adapter() { # $1 = package's native dir, $2 = dir holding the artifact (may carry its own adapter)
	local native_dir="$1" artifact_dir="$2" src
	for src in "$SRC/packages/natives/native" "$artifact_dir"; do
		if [ -f "$src/desktop-adapter.js" ]; then
			cp -f "$src/desktop-adapter.js" "$native_dir/desktop-adapter.js"
			return 0
		fi
	done
	warn "no desktop-adapter.js found: DesktopSession will be a broken adapter class"
}

install_addon() { # $1 = path to a .node
	local addon="$1" target_version="" n=0 seen="" d v artifact_dir
	[ -f "$addon" ] || die "no artifact to install: $addon"
	artifact_dir="$(cd "$(dirname "$addon")" && pwd)"
	# The artifact's sentinel is what the loader checks, so it decides the target version; a build tree is
	# only a fallback when the sentinel cannot be read.
	target_version="$(artifact_version "$addon")"
	if [ -n "$target_version" ]; then
		msg "target version from the artifact's sentinel: $target_version"
	elif [ -f "$SRC/packages/natives/package.json" ]; then
		target_version="$(json_version "$SRC/packages/natives/package.json")"
	fi
	while IFS= read -r d; do
		v="$(json_version "$d/package.json")"
		if [ -n "$target_version" ] && [ "$v" != "$target_version" ]; then
			# The loader compares the sentinel against the package, so a copy of another version must not
			# receive this binary. Superseded copies are reclaimed later; this pass only records them.
			seen="${seen:+$seen, }${v:-unknown}"
			continue
		fi
		mkdir -p "$d/native"
		cp -f "$addon" "$d/native/$ADDON"
		copy_adapter "$d/native" "$artifact_dir"
		msg "installed -> $d/native/$ADDON$(is_workspace_load "$d" && echo ' [workspace-load: sentinel check skipped]' || echo ' [node_modules: sentinel is enforced, versions must match]')"
		n=$((n + 1))
	done < <(natives_dirs)
	[ "$n" -gt 0 ] || die "no @oh-my-pi/pi-natives for ${target_version:-the artifact} on this device${seen:+ (found: $seen)}; install omp first: bun install -g @oh-my-pi/pi-coding-agent"
}

link_global_tree() { # On Termux, `bun install -g` (upstream's documented way) leaves <root>/bin/omp resolving
	# into <root>/install/cache/<pkg>@<version>@@@1, where no node_modules exists, so lazily imported
	# packages fail — `omp stats` dies with "Cannot find module '@oh-my-pi/pi-natives'" — while the rest of
	# the CLI starts. Linking the global tree into <cache>/node_modules restores that resolution.
	local root cache global entry name
	while IFS= read -r root; do
		cache="$root/install/cache"
		global="$root/install/global/node_modules"
		[ -d "$cache" ] && [ -d "$global" ] || continue
		mkdir -p "$cache/node_modules"
		for entry in "$global"/*; do
			[ -e "$entry" ] || continue
			name="$(basename "$entry")"
			if [ -L "$cache/node_modules/$name" ]; then
				ln -sfn "$entry" "$cache/node_modules/$name"
			elif [ -d "$cache/node_modules/$name" ]; then
				# `ln -sfn` into an existing directory creates a link *inside* it; leave the directory alone.
				warn "not linking $name: $cache/node_modules/$name is a directory, not a link"
			elif [ ! -e "$cache/node_modules/$name" ]; then
				ln -s "$entry" "$cache/node_modules/$name"
			fi
		done
	done < <(bun_roots)
}

has_other_link_ref() { # $1 = candidate dir, $2 = bun's own nested sibling link (ignored)
	local want ignore root l
	want="$(readlink -f "$1" 2>/dev/null)"
	[ -n "$want" ] || return 1
	ignore="$(readlink -f "${2:-/nonexistent}" 2>/dev/null)"
	while IFS= read -r root; do
		while IFS= read -r l; do
			[ "$l" = "${2:-}" ] && continue
			[ -n "$ignore" ] && [ "$l" = "$ignore" ] && continue
			[ "$(readlink -f "$l" 2>/dev/null)" = "$want" ] && return 0
		done < <(find "$root/install" -maxdepth 6 -type l 2>/dev/null)
	done < <(bun_roots)
	return 1
}

prune_superseded() { # $1 = the version now installed; drops older pi-natives copies from bun's cache
	# Only the cache tree, only strictly older versions, and never through a symlink: `find` without -L does
	# not descend into <cache>/node_modules/<scope>, which is the link that reaches the copy in use.
	local keep="${1:-}" root cache d v sz base stem nested
	[ -n "$keep" ] || return 0
	while IFS= read -r root; do
		cache="$root/install/cache"
		[ -d "$cache" ] || continue
		while IFS= read -r d; do
			v="$(json_version "$d/package.json")"
			[ -n "$v" ] && [ "$v" != "$keep" ] || continue
			[ "$(printf '%s\n%s\n' "$v" "$keep" | sort -V | head -n1)" = "$v" ] || continue
			base="$(basename "$d")"
			stem="${base%@@@1}"
			nested="$(dirname "$d")/${stem%@*}/${stem#*@}@@@1"
			if has_other_link_ref "$d" "$nested"; then
				warn "keeping the $v copy: a link still points at it"
				continue
			fi
			sz="$(du -sh "$d" 2>/dev/null | cut -f1)"
			[ -L "$nested" ] && rm -f "$nested"
			rm -rf "$d" && msg "removed the superseded $v copy${sz:+ ($sz)}"
		done < <(find "$cache" -maxdepth 3 -type d -path '*@oh-my-pi/pi-natives*' 2>/dev/null)
	done < <(bun_roots)
}

device_ensure_bun() { # install bun on this device when it is missing; the workstation path has its own copy
	local root tmp
	[ -n "$(bun_path)" ] && return 0
	msg "installing bun"
	if command -v pkg >/dev/null 2>&1 && pkg install -y bun >/dev/null 2>&1 && [ -n "$(bun_path)" ]; then
		use_root
		return 0
	fi
	root="$(bun_root)"
	tmp="${TMPDIR:-$HOME}/omp-bun.$$"
	mkdir -p "$tmp" "$root/bin" || return 1
	curl -fsSL -o "$tmp/bun.zip" https://github.com/oven-sh/bun/releases/latest/download/bun-linux-aarch64-android.zip || { rm -rf "$tmp"; return 1; }
	unzip -oq "$tmp/bun.zip" -d "$tmp" || { rm -rf "$tmp"; return 1; }
	cp -f "$tmp"/bun-linux-aarch64-android/bun "$root/bin/bun" || { rm -rf "$tmp"; return 1; }
	chmod +x "$root/bin/bun"
	rm -rf "$tmp"
	BUN_INSTALL="$root"; export BUN_INSTALL
	PATH="$root/bin:$PATH"; export PATH
	[ -n "$(bun_path)" ]
}

fetch_release() { # $1 = pi-natives version; puts the addon in RELEASE_ADDON, dies when the release is missing
	local version="$1" base f sentinel
	base="${OMP_TERMUX_RELEASE_BASE:-https://github.com/$REPO/releases/download/omp-$version}"
	msg "fetching pi-natives $version for android-arm64"
	mkdir -p "$HOME/$SCRATCH"
	for f in "$ADDON" desktop-adapter.js; do
		# .part then rename: curl fails a length mismatch, so a partial file never takes the addon's name
		curl -fsSL --retry 3 "$base/$f" -o "$HOME/$SCRATCH/$f.part" || {
			rm -rf "$HOME/$SCRATCH"
			die "no release for $version at $base; nothing was changed"
		}
		mv -f "$HOME/$SCRATCH/$f.part" "$HOME/$SCRATCH/$f"
	done
	sentinel="$(artifact_version "$HOME/$SCRATCH/$ADDON")"
	if [ "$sentinel" != "$version" ]; then
		rm -rf "$HOME/$SCRATCH"
		die "the downloaded addon is $([ -n "$sentinel" ] && echo "for $sentinel, not $version" || echo "not a pi-natives build"); nothing was changed"
	fi
	RELEASE_ADDON="$HOME/$SCRATCH/$ADDON"
}

device_install() { # $1 = version, "latest", or a path to a .node; no argument = the version this device runs
	local arg="${1:-}" want current up="" pub="" bun vlog
	link_global_tree
	if [ -n "$arg" ] && [ -f "$arg" ]; then
		install_addon "$arg"
		cmd_install_self
		return 0
	fi
	# a device can only be brought to a version this repository published
	pub="$(latest_release_version)"
	case "$arg" in
		"")
			want="${OMP_TERMUX_VERSION:-$(installed_version)}"
			if [ -z "$want" ]; then
				[ -n "$pub" ] || die "no omp on this device and no published build to install (network?); pass one: omp-termux install <version>"
				want="$pub"
				msg "no omp on this device yet — installing $want (the newest build published here)"
			fi
			;;
		latest)
			[ -n "$pub" ] || die "cannot resolve the newest build published here (network?); nothing was changed"
			want="$pub"
			up="$(latest_version)"
			;;
		*) want="${arg#v}" ;;
	esac
	installed_state
	if [ -n "$pub" ]; then
		panel_line "newest build here" "omp-$pub"
	fi
	if [ -n "$up" ] && version_gt "$up" "$want"; then
		msg "upstream $up is published but has no build here yet"
	fi
	# run_verify dies on a failed load, so it runs in a subshell; its output matters only when it fails
	mkdir -p "$HOME/$SCRATCH"
	vlog="$HOME/$SCRATCH/verify.log"
	if [ "$CUR_VERSION" = "$want" ] && [ -f "$CUR_ADDON" ] && ( run_verify ) >"$vlog" 2>&1; then
		panel_line "you have" "omp-$CUR_VERSION (addon in place, loads OK)"
		rm -f "$vlog"
		rm -rf "$HOME/$SCRATCH"
		cmd_install_self
		msg "nothing to do"
		return 0
	fi
	if [ -s "$vlog" ]; then
		warn "the installed addon does not load; reinstalling it"
	fi
	rm -f "$vlog"
	panel_line "you have" "omp-${CUR_VERSION:-none}$([ -n "$CUR_VERSION" ] && [ ! -f "$CUR_ADDON" ] && echo ' (addon missing)')"
	if [ -n "$CUR_VERSION" ] && [ -n "$pub" ] && version_gt "$CUR_VERSION" "$pub"; then
		die "no build published here for the omp you run: $CUR_VERSION (newest: omp-$pub); nothing was changed
        wait for that build, or step back: bun install -g @oh-my-pi/pi-coding-agent@$pub"
	fi
	# Fetch before moving omp: an upgrade without the matching addon in hand leaves omp unable to start.
	device_ensure_bun || die "cannot install bun; install it by hand: pkg install bun"
	fetch_release "$want"
	current="$CUR_VERSION"
	if [ "$current" != "$want" ]; then
		use_root
		bun="$(bun_path)" || die "bun not found; install it first: pkg install bun"
		msg "installing omp $want on this device (currently ${current:-none})"
		"$bun" install -g "@oh-my-pi/pi-coding-agent@$want" || die "installing omp $want failed"
	fi
	install_addon "$RELEASE_ADDON"
	rm -rf "$HOME/$SCRATCH"
	run_verify
	prune_superseded "$want"
	cmd_install_self
}

run_verify() { # load the addon through the real loader, then smoke-test the CLI
	local probe_dir="$WORK" probe d rc=0 real bun_bin
	[ "$MODE" = device ] && probe_dir="$HOME/$SCRATCH"   # never leave a probe behind on the device
	probe="$probe_dir/probe.mjs"
	bun_bin="$(bun_path)"
	mkdir -p "$probe_dir"
	cat >"$probe" <<'EOF'
const target = process.argv[2]
const mod = await import(target)
const required = ["countTokens", "visibleWidth", "grep", "Shell", "PtySession", "TtyWriter", "EditSession"]
const missing = required.filter(n => mod[n] === undefined)
const absent = ["DesktopSession", "copyToClipboard", "AudioCapture"].filter(n => mod[n] === undefined)
console.log(`  runtime ${process.platform}-${process.arch}: ${Object.keys(mod).length} exports, ${required.length - missing.length}/${required.length} core exports`)
if (absent.length) console.log(`  platform-trimmed modules (expected on Android): ${absent.join(", ")}`)
if (missing.length) { console.error("  missing:", missing.join(", ")); process.exit(1) }
console.log("  NATIVE LOAD OK")
EOF
	while IFS= read -r d; do
		msg "loading through the loader: $d"
		[ -n "$bun_bin" ] || { warn "bun not found (looked for 'bun' on PATH and under $(bun_root)); cannot load-test $d"; rc=1; continue; }
		"$bun_bin" "$probe" "$d/native/index.js" || { warn "load failed: $d"; rc=1; }
	done < <(natives_dirs)
	rm -f "$probe"
	rmdir "$probe_dir" 2>/dev/null || true
	# `omp` is whatever the user installed with bun, never ours. The roots are searched because the shell
	# the tool runs in has no bun bin directory on PATH, and a copy outside the root in use is reported.
	real="$(omp_path)"
	if [ -n "$real" ]; then
		msg "$real --version"
		"$real" --version || { warn "omp still fails to start"; rc=1; }
		case "$real" in
			"$(bun_active_root)"/bin/omp) ;;
			*) warn "$real is not the copy in use ($(bun_active_root)/bin/omp)" ;;
		esac
	else
		warn "no omp binary found (PATH and $(bun_active_root)/bin); cannot smoke-test the CLI"
	fi
	[ "$rc" -eq 0 ] || die "verification failed"
	msg "all good"
}

print_status() {
	local d v f omp_bin rel
	omp_bin="$(omp_path)"
	printf 'mode       : %s\n' "$MODE"
	printf 'tool       : %s\n' "$SELF"
	printf 'version    : %s\n' "$(tool_label)"
	rel="$(cache_get release)"       # filled by the self-update check: status makes no request itself
	[ -n "$rel" ] && printf 'newest here: omp-%s\n' "$rel"
	printf 'omp binary : %s\n' "${omp_bin:-not found}"
	echo
	while IFS= read -r d; do
		v="$(json_version "$d/package.json")"
		f="$d/native/$ADDON"
		printf '%s\n  version=%s  addon=%s%s\n' "$d" "$v" \
			"$([ -f "$f" ] && echo "$(du -h "$f" | cut -f1) $(date -r "$f" '+%F %T')" || echo missing)" \
			"$(is_workspace_load "$d" && echo '  [workspace-load]' || echo '  [node_modules: sentinel enforced]')"
	done < <(natives_dirs)
}

# --- upstream source, patch, dependencies ------------------------------------------------------------

fetch_source() { # $1 = version
	local ref="v$1"
	mkdir -p "$WORK"
	if [ ! -d "$SRC/.git" ]; then
		msg "cloning upstream $ref"
		rm -rf "$SRC"
		git clone --depth 1 --single-branch --branch "$ref" "$UPSTREAM" "$SRC" ||
			die "clone failed: does tag '$ref' exist?"
	else
		msg "updating upstream -> $ref"
		git -C "$SRC" fetch --depth 1 origin "$ref" || die "fetch '$ref' failed"
		git -C "$SRC" checkout -f FETCH_HEAD
		git -C "$SRC" reset --hard FETCH_HEAD >/dev/null
	fi
	printf '%s\n' "$ref" >"$WORK/source-ref"
}

apply_patch() {
	local marker="$SRC/packages/natives/scripts/build-bindings.ts"
	[ -f "$marker" ] || die "source tree looks wrong: $marker missing"
	if grep -q 'RUSTC_BOOTSTRAP' "$marker" 2>/dev/null; then
		msg "patch already present in the source tree (upstream may have merged it), skipping"
		return
	fi
	if [ ! -f "$PATCH" ]; then
		msg "downloading upstream patch (PR #$PR)"
		curl -fsSL "$PR_PATCH_URL" -o "$PATCH" || die "patch download failed: $PR_PATCH_URL"
	fi
	msg "applying $(basename "$PATCH")"
	git -C "$SRC" apply --exclude='*CHANGELOG.md' "$PATCH" ||
		die "patch did not apply — upstream changed those files. Patch kept at $PATCH"
	grep -q 'RUSTC_BOOTSTRAP' "$marker" || die "patch applied but had no effect"
}

install_build_deps() {
	local napi_version
	napi_version="$(sed -n 's/.*"@napi-rs\/cli"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/package.json" | head -n1)"
	[ -n "$napi_version" ] || die "cannot read @napi-rs/cli version from $SRC/package.json"
	if [ -d "$SRC/packages/natives/node_modules/@napi-rs/cli" ]; then
		msg "@napi-rs/cli already available"
		return
	fi
	if [ -e "$SRC/packages/natives/node_modules" ]; then
		msg "installing @napi-rs/cli@$napi_version into the existing source node_modules"
		(cd "$SRC/packages/natives" && bun add --ignore-scripts "@napi-rs/cli@$napi_version") || die "bun add failed"
		return
	fi
	# A plain `bun install` in packages/natives resolves the whole monorepo (~400 packages, ~1.5 GB);
	# installing the CLI standalone and symlinking costs ~67 packages / ~56 MB instead.
	msg "installing @napi-rs/cli@$napi_version standalone"
	mkdir -p "$NAPI_CLI_DIR"
	[ -f "$NAPI_CLI_DIR/package.json" ] || echo '{}' >"$NAPI_CLI_DIR/package.json"
	(cd "$NAPI_CLI_DIR" && bun add --ignore-scripts "@napi-rs/cli@$napi_version") || die "bun add failed"
	ln -sfn "$NAPI_CLI_DIR/node_modules" "$SRC/packages/natives/node_modules"
	[ -d "$SRC/packages/natives/node_modules/@napi-rs/cli" ] || die "@napi-rs/cli still unresolvable after linking"
}

# --- build: on the device (native) -------------------------------------------------------------------

device_build() { # $1 = version (default: the one installed on this device)
	local version="${1:-$(installed_version)}" ref src_version
	version="${version#v}"
	[ -n "$version" ] || die "no installed @oh-my-pi/pi-natives; install omp first: bun install -g @oh-my-pi/pi-coding-agent"
	msg "building on device (profile=ci) — expect hours; run it inside tmux"
	fetch_source "$version"
	src_version="$(json_version "$SRC/packages/natives/package.json")"
	[ "$src_version" = "$version" ] ||
		warn "source version $src_version != installed version $version (usually still fine: the loader skips the sentinel check for Bun's cache layout)"
	apply_patch
	install_build_deps
	have termux-wake-lock && { termux-wake-lock; trap 'termux-wake-unlock >/dev/null 2>&1 || true' EXIT; }
	export OMP_NATIVE_CARGO_PROFILE=ci
	export RUSTC_BOOTSTRAP="${RUSTC_BOOTSTRAP:-xutf,pi_natives}"
	export CARGO_TARGET_DIR="$CARGO_TARGET"
	(cd "$SRC/packages/natives" && bun scripts/build-bindings.ts) || die "build failed (see the output above)"
	local built="$SRC/packages/natives/native/$ADDON"
	if [ ! -f "$built" ]; then
		built="$(find "$SRC/packages/natives/native" -maxdepth 1 -name 'pi_natives*.node' | head -n1)"
		[ -n "$built" ] || die "build finished but produced no addon"
		mv "$built" "$SRC/packages/natives/native/$ADDON"
		built="$SRC/packages/natives/native/$ADDON"
	fi
	mkdir -p "$WORK"
	cp -f "$built" "$WORK/$ADDON"
	msg "artifact $WORK/$ADDON ($(du -h "$WORK/$ADDON" | cut -f1))"
}

# --- build: on the workstation (cross-compile) -------------------------------------------------------

ensure_rust_target() {
	local channel
	channel="$(sed -n 's/^channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/rust-toolchain.toml" 2>/dev/null | head -n1 || true)"
	[ -n "$channel" ] || die "cannot read the pinned channel from $SRC/rust-toolchain.toml"
	msg "upstream pins rust toolchain: $channel"
	if rustup target list --installed --toolchain "$channel" 2>/dev/null | grep -qx aarch64-linux-android; then
		msg "aarch64-linux-android std already installed"
	else
		msg "installing aarch64-linux-android std for $channel"
		rustup target add aarch64-linux-android --toolchain "$channel" || die "rustup target add failed"
	fi
}

prepare_opus() {
	local base src dir
	# audiopus_sys declares no rerun-if-env-changed, so Cargo reuses the rlib left by an earlier
	# (host-ABI) cmake run. Remove the build directory on every call.
	rm -rf "$CARGO_TARGET/aarch64-linux-android/ci/build/audiopus_sys"
	if [ -f "$OPUS_PREFIX/lib/libopus.a" ]; then
		msg "opus already built: $OPUS_PREFIX"
		return
	fi
	msg "fetching crate sources (cargo fetch)"
	(cd "$SRC" && cargo fetch --manifest-path crates/pi-natives/Cargo.toml >/dev/null 2>&1) || warn "cargo fetch failed; continuing"
	src=""
	for base in "${CARGO_HOME:-}" "$HOME/.cargo" "$HOME/.local/share/cargo"; do
		[ -n "$base" ] || continue
		dir="$(ls -d "$base"/registry/src/*/audiopus_sys-*/opus 2>/dev/null | head -n1 || true)"
		[ -n "$dir" ] && { src="$dir"; break; }
	done
	[ -n "$src" ] || die "cannot locate the vendored opus sources inside audiopus_sys"
	msg "cross-building opus for arm64-v8a (API $API)"
	rm -rf "$WORK/opus-build" "$OPUS_PREFIX"
	# -DCMAKE_POLICY_VERSION_MINIMUM: opus' CMakeLists predates CMake 4.
	cmake -S "$src" -B "$WORK/opus-build" -G Ninja \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_TOOLCHAIN_FILE="$NDK/build/cmake/android.toolchain.cmake" \
		-DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM="android-$API" \
		-DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
		-DOPUS_BUILD_PROGRAMS=OFF -DOPUS_BUILD_TESTING=OFF -DOPUS_BUILD_SHARED_LIBRARY=OFF \
		-DCMAKE_INSTALL_PREFIX="$OPUS_PREFIX" >"$WORK/opus.log" 2>&1 ||
		die "opus cmake configure failed, see $WORK/opus.log"
	cmake --build "$WORK/opus-build" -j "$(nproc)" >>"$WORK/opus.log" 2>&1 || die "opus build failed, see $WORK/opus.log"
	cmake --install "$WORK/opus-build" >>"$WORK/opus.log" 2>&1 || die "opus install failed"
	[ -f "$OPUS_PREFIX/lib/libopus.a" ] || die "opus installed but libopus.a is missing"
	msg "opus ready ($(du -h "$OPUS_PREFIX/lib/libopus.a" | cut -f1))"
}

cross_build() {
	local tc="$NDK/toolchains/llvm/prebuilt/linux-x86_64"
	ndk_ok || die "NDK incomplete, run 'omp-termux doctor' first"
	mkdir -p "$OUT"
	rm -f "$OUT/$ADDON"
	msg "cross-compiling aarch64-linux-android (API $API)"
	(
		cd "$SRC/packages/natives"
		env \
			ANDROID_NDK_LATEST_HOME="$NDK" \
			ANDROID_NDK_HOME="$NDK" \
			ANDROID_NDK_ROOT="$NDK" \
			LIBOPUS_LIB_DIR="$OPUS_PREFIX" \
			LIBOPUS_STATIC=1 \
			LIBOPUS_NO_PKG=1 \
			BINDGEN_EXTRA_CLANG_ARGS_aarch64_linux_android="--sysroot=$tc/sysroot --target=aarch64-linux-android$API" \
			RUSTC_BOOTSTRAP="${RUSTC_BOOTSTRAP:-xutf,pi_natives}" \
			CARGO_TARGET_DIR="$CARGO_TARGET" \
			bun "$NAPI_CLI_DIR/node_modules/@napi-rs/cli/dist/cli.js" build \
			--manifest-path "$SRC/crates/pi-natives/Cargo.toml" \
			--package-json-path "$SRC/packages/natives/package.json" \
			--target aarch64-linux-android \
			--no-js --dts index.d.ts \
			-o "$OUT" --profile ci
	) || die "cross-compilation failed"
	finalize_artifact
}

# The loader looks for pi_natives.<platform>-<arch>.node, while @napi-rs/cli --target emits a bare name.
# The script itself ships in out/ because install.sh fetches it alongside the addon.
finalize_artifact() {
	local produced
	if [ ! -f "$OUT/$ADDON" ]; then
		produced="$(find "$OUT" -maxdepth 1 -name 'pi_natives*.node' | head -n1)"
		[ -n "$produced" ] || die "build finished but produced no addon"
		msg "renaming $(basename "$produced") -> $ADDON"
		mv "$produced" "$OUT/$ADDON"
	fi
	cp -f "$SRC/packages/natives/native/desktop-adapter.js" "$OUT/desktop-adapter.js"
	cp -f "$SELF" "$OUT/omp-termux" && chmod +x "$OUT/omp-termux"
}

verify_artifact() {
	local addon="$OUT/$ADDON" info sentinel
	[ -f "$addon" ] || die "artifact missing: $addon"
	msg "verifying $addon"
	info="$(file -b "$addon")"
	echo "  $info"
	case "$info" in
		*"ARM aarch64"*) ;;
		*) die "artifact is not aarch64: $info" ;;
	esac
	case "$info" in
		*Android*) msg "file reports an Android target" ;;
		*) warn "file does not report Android — toolchain wiring may be wrong" ;;
	esac
	readelf -d "$addon" 2>/dev/null | grep NEEDED || true
	if readelf -V "$addon" 2>/dev/null | grep -q 'GLIBC_'; then
		die "artifact carries GLIBC_* version requirements — not a bionic object"
	fi
	if readelf -d "$addon" 2>/dev/null | grep -qE 'libc\.so\.6|ld-linux'; then
		die "artifact links glibc — it will not run on the device"
	fi
	msg "dynamic deps are bionic-only (libc.so / libdl.so / libm.so)"
	nm -D --defined-only "$addon" 2>/dev/null | grep -q napi_register_module_v1 &&
		msg "N-API entrypoint napi_register_module_v1 present"
	sentinel="$(grep -ao '__piNativesV[0-9A-Za-z_]*' "$addon" | head -n1)"
	[ -n "$sentinel" ] || die "no version sentinel in the artifact — the loader would reject it"
	msg "embedded sentinel: $sentinel (must equal the installed @oh-my-pi/pi-natives version)"
	du -h "$addon" | sed 's/^/  size /'
}

workstation_build() { # $1 = version
	local version="${1:-$(latest_version)}"
	version="${version#v}"
	[ -n "$version" ] || die "no version given and the upstream release lookup failed: omp-termux build <version>"
	msg "target omp version: $version"
	ndk_ok || die "NDK missing — run 'omp-termux doctor' and install it"
	fetch_source "$version"
	ensure_rust_target
	apply_patch
	install_build_deps
	prepare_opus
	cross_build
	verify_artifact
	msg "artifact for $version is in $OUT"
}

ensure_artifact() { # $1 = version
	local want="$1" built_version
	built_version="$(artifact_version "$OUT/$ADDON")"
	if [ "$built_version" = "$want" ]; then
		msg "using the $want artifact already built in $OUT"
	else
		[ -n "$built_version" ] && msg "$OUT holds $built_version, rebuilding for $want"
		workstation_build "$want"
	fi
}

# --- workstation: device access ----------------------------------------------------------------------

device_ssh() { # $1 = POSIX sh command; sshd would otherwise run it with the login shell (fish, zsh, ...)
	local host port
	host="$(device_host)"
	port="$(device_port)"
	[ -n "$host" ] || die "no device configured: run 'omp-termux device user@host' (or export OMP_TERMUX_HOST=user@host)"
	ssh -p "$port" -o ConnectTimeout=10 "$host" "sh -c $(printf '%q' "$1")"
}

device_scp() { # $1 = local file, $2 = remote dir (relative to $HOME)
	local port
	port="$(device_port)"
	scp -P "$port" -q "$1" "$(device_host):~/$2/" ||
		scp -P "$port" -O -q "$1" "$(device_host):~/$2/" ||
		die "could not copy $(basename "$1") (try: pkg install openssh-sftp-server on the device)"
}

remote_bun() { # $1 = bun arguments as one shell-quoted string
	device_ssh "$(remote_bun_env); bun $1"
}

ensure_device_bun() {
	if device_ssh "$(remote_bun_env); command -v bun >/dev/null 2>&1"; then
		msg "bun is present on the device"
		return 0
	fi
	msg "installing bun on the device (pkg install bun)"
	device_ssh "$(remote_bun_env); { pkg install -y bun >/dev/null 2>&1 || true; }; command -v bun >/dev/null 2>&1" && return 0
	msg "pkg install did not provide bun; fetching the Android build"
	device_ssh 'tmp="${TMPDIR:-$HOME}/omp-bun.$$"; dir=$('"$(remote_bun_root)"'); mkdir -p "$tmp" "$dir/bin" && curl -fsSL -o "$tmp/bun.zip" https://github.com/oven-sh/bun/releases/latest/download/bun-linux-aarch64-android.zip && unzip -oq "$tmp/bun.zip" -d "$tmp" && cp -f "$tmp"/bun-linux-aarch64-android/bun "$dir/bin/bun" && chmod +x "$dir/bin/bun"; rc=$?; rm -rf "$tmp"; exit $rc' ||
		die "could not install bun on the device"
	msg "bun installed on the device"
}

ensure_device_version() { # $1 = target version; installs omp on the device when it differs
	local want="$1" current
	ensure_device_bun
	current="$(device_installed_version)"
	if [ "$current" = "$want" ]; then
		msg "device already runs @oh-my-pi/pi-coding-agent@$want"
		return 0
	fi
	msg "installing omp on the device: @oh-my-pi/pi-coding-agent@$want (currently ${current:-none})"
	remote_bun "install -g @oh-my-pi/pi-coding-agent@$want" || die "failed to install omp on the device"
}

# Run a device-side command without installing anything: the script is uploaded to ~/$SCRATCH, executed,
# and the scratch dir is removed in the same session.
device_run() { # $1 = command line for the script on the device
	device_ssh "mkdir -p ~/$SCRATCH" ||
		die "ssh failed — is sshd running on the device (pkg install openssh; sshd) and the port right?"
	device_scp "$SELF" "$SCRATCH"
	device_ssh "$(remote_bun_env); OMP_TERMUX_MODE=device bash ~/$SCRATCH/omp-termux $1; rc=\$?; rm -rf ~/$SCRATCH; exit \$rc"
}

# Upload the built artifact next to the tool in the same scratch dir.
device_upload() {
	local f
	device_ssh "mkdir -p ~/$SCRATCH" || die "ssh failed"
	for f in "$ADDON" desktop-adapter.js; do
		[ -f "$OUT/$f" ] || continue
		msg "copying $f"
		device_scp "$OUT/$f" "$SCRATCH"
	done
}

device_installed_version() { # "" when the device has no @oh-my-pi/pi-natives or ssh fails
	device_ssh 'r=$('"$(remote_bun_root)"'); for p in "$r"/install/global/node_modules/@oh-my-pi/pi-natives/package.json "$r"/install/cache/@oh-my-pi/pi-natives@*/package.json; do [ -f "$p" ] && sed -n "s/.*\"version\": *\"\([^\"]*\)\".*/\1/p" "$p" | head -n1; done | sort -V | tail -n1; exit 0' 2>/dev/null || true
}

# Sets TARGET_VERSION and TARGET_FILE (empty unless the caller passed a local artifact).
resolve_target() {
	local arg="${1:-}"
	TARGET_VERSION=""
	TARGET_FILE=""
	if [ -n "$arg" ] && [ -f "$arg" ]; then
		TARGET_FILE="$arg"
		TARGET_VERSION="$(artifact_version "$arg")"
		msg "installing the local artifact $arg${TARGET_VERSION:+ (sentinel $TARGET_VERSION)}"
	elif [ -n "$arg" ]; then
		TARGET_VERSION="${arg#v}"
		if [ "$TARGET_VERSION" = latest ]; then
			resolve_latest
			TARGET_VERSION="$LATEST"
		fi
	else
		TARGET_VERSION="$(device_installed_version)"
		if [ -n "$TARGET_VERSION" ]; then
			msg "device has @oh-my-pi/pi-natives@$TARGET_VERSION"
		else
			TARGET_VERSION="$(latest_version)"
			[ -n "$TARGET_VERSION" ] || die "cannot resolve the upstream release; pass one: omp-termux install <version>"
			msg "no omp on the device yet; installing @oh-my-pi/pi-coding-agent@$TARGET_VERSION"
		fi
	fi
}

install_on_device() {
	device_upload
	msg "installing on the device"
	device_run "install ~/$SCRATCH/$ADDON" || die "installing the addon on the device failed"
	msg "verifying on the device"
	device_run verify || die "verification failed on the device"
}

workstation_install() { # $1 = version, "latest", or a path to a .node (default: what the device runs)
	resolve_target "${1:-}"
	if [ -n "$TARGET_VERSION" ]; then
		ensure_device_version "$TARGET_VERSION"
	else
		warn "the artifact carries no readable sentinel; skipping the device omp check"
	fi
	if [ -n "$TARGET_FILE" ]; then
		[ "$TARGET_FILE" = "$OUT/$ADDON" ] || { mkdir -p "$OUT"; cp -f "$TARGET_FILE" "$OUT/$ADDON"; }
	else
		ensure_artifact "$TARGET_VERSION"
	fi
	install_on_device
}

link_self() { # $PREFIX/bin/omp-termux linked into $BINDIR; quiet while the link is already right
	local target="$BINDIR/omp-termux" want="$PREFIX/bin/omp-termux"
	if [ -d "$target" ] && [ ! -L "$target" ]; then
		# `ln -sfn` into a directory links inside it instead; leave a real directory alone.
		warn "not linking $target: it is a directory, not a link"
		return 0
	fi
	if [ "$(readlink "$target" 2>/dev/null)" = "$want" ]; then
		path_reminder   # the link is right, but $BINDIR may still be missing from PATH
		return 0
	fi
	mkdir -p "$BINDIR"
	ln -sfn "$want" "$target"
	msg "linked $target -> $want"
	path_reminder
}

cmd_install_self() { # keep this tool on PATH: $PREFIX, linked into $BINDIR
	local f
	mkdir -p "$PREFIX/bin" "$PREFIX/patches"
	# Running the installed copy is the normal case on a device: copying it onto itself would fail.
	[ "$SELF" = "$PREFIX/bin/omp-termux" ] || install -m 0755 "$SELF" "$PREFIX/bin/omp-termux"
	for f in "$PROJ"/patches/*.patch "$SELF_DIR"/patches/*.patch; do
		[ -f "$f" ] && cp -f "$f" "$PREFIX/patches/"
	done
	link_self
}

cmd_update_self() {
	local tmp old new
	tmp="$PREFIX/bin/omp-termux.new"
	mkdir -p "$PREFIX/bin"
	msg "fetching $SELF_URL"
	curl -fsSL "$SELF_URL" -o "$tmp" || { rm -f "$tmp"; die "cannot fetch $SELF_URL"; }
	if ! bash -n "$tmp" 2>/dev/null; then
		rm -f "$tmp"
		die "the downloaded script is not valid shell; kept the installed copy"
	fi
	old="$(file_sha "$PREFIX/bin/omp-termux")"
	new="$(file_sha "$tmp")"
	if [ -n "$old" ] && [ "$old" = "$new" ]; then
		rm -f "$tmp"
		msg "already up to date (${new:0:12})"
		return 0
	fi
	mv -f "$tmp" "$PREFIX/bin/omp-termux"
	chmod 0755 "$PREFIX/bin/omp-termux"
	rm -f "$SELF_CACHE"     # the next check must re-fetch, not compare against the replaced copy's hash
	msg "updated ${old:0:12} -> ${new:0:12}"
	link_self
}

tool_label() { printf 'v%s (%s)' "$TOOL_VERSION" "$(file_sha "$SELF" | cut -c1-12)"; }

cmd_uninstall_self() {
	msg "removing $BINDIR/omp-termux and $PREFIX"
	rm -f "$BINDIR/omp-termux"
	rm -rf "$PREFIX"
	rmdir "$(dirname "$PREFIX")" 2>/dev/null || true   # leave no empty ~/.local/opt behind
}

cmd_device() { # $1 = user@host to save; no argument shows the current target
	local arg="${1:-}" host
	case "$arg" in
		-*) die "unexpected option: $arg (usage: omp-termux device [user@host])" ;;
		*[!A-Za-z0-9._@:-]*) die "not a device target: $arg" ;;
	esac
	if [ -n "$arg" ]; then
		mkdir -p "$(dirname "$CFG")"
		{
			printf 'OMP_TERMUX_HOST=%s\n' "$arg"
			printf 'OMP_TERMUX_PORT=%s\n' "$(device_port)"
		} >"$CFG"
		msg "saved $CFG"
		host="$arg"                     # report what was just written, not what was read at startup
	else
		host="$(device_host)"
	fi
	printf 'host   : %s\n' "${host:-<unset>}"
	printf 'port   : %s\n' "$(device_port)"
	printf 'config : %s%s\n' "$CFG" "$([ -f "$CFG" ] && echo '' || echo ' (not created yet)')"
}

device_doctor() {
	local bun_bin omp_bin
	bun_bin="$(bun_path)"
	omp_bin="$(omp_path)"
	msg "environment check (device)"
	printf '  Termux         : %s\n' "${TERMUX_VERSION:-not detected}"
	printf '  uname          : %s %s\n' "$(uname -s)" "$(uname -m)"
	printf '  tool           : %s\n' "$SELF"
	printf '  omp-termux     : %s\n' "$(tool_label)"
	printf '  bun            : %s\n' "${bun_bin:-MISSING}"
	printf '  rustc / cargo  : %s / %s\n' "$(have rustc && rustc -vV | sed -n 's/^release: /release=/p' || echo 'MISSING (only needed for omp-termux build)')" "$(have cargo && cargo --version || echo MISSING)"
	printf '  omp binary     : %s\n' "${omp_bin:-not found}"
	printf '  pi-natives     : %s\n' "$(installed_version || echo 'not found')"
	printf '  free space     : %s\n' "$(df -h "$HOME" 2>/dev/null | awk 'NR==2{print $4}')"
	[ -n "$bun_bin" ] || warn "bun is missing: pkg install bun (or curl -fsSL https://bun.sh/install | bash)"
}

workstation_doctor() {
	msg "cross toolchain check"
	printf '  mode           : %s\n' "$MODE"
	printf '  omp-termux     : %s\n' "$(tool_label)"
	printf '  NDK            : %s%s\n' "${NDK:-<none>}" "$(ndk_ok && echo ' ok' || echo ' MISSING')"
	printf '  rustup         : %s\n' "$(have rustup && rustup --version 2>/dev/null | head -n1 || echo 'MISSING (required)')"
	printf '  cargo / bun    : %s / %s\n' "$(have cargo && cargo --version || echo MISSING)" "$(have bun && bun --version || echo MISSING)"
	printf '  git/curl/unzip : %s %s %s\n' "$(have git && echo ok || echo no)" "$(have curl && echo ok || echo no)" "$(have unzip && echo ok || echo no)"
	printf '  cmake / ninja  : %s / %s\n' "$(have cmake && cmake --version | head -n1 || echo 'MISSING (needed for opus)')" "$(have ninja && ninja --version || echo MISSING)"
	printf '  patch          : %s\n' "$PATCH"
	printf '  device         : %s\n' "$(device_host || true)"
	if ! ndk_ok; then
		warn "no NDK found. Install one the usual way, then re-run:"
		printf '  sdkmanager "ndk;<version>"           # Android Studio SDK (uses ANDROID_HOME)\n'
		printf '  paru -S android-ndk                  # or the distro package\n'
		printf '  export ANDROID_NDK_ROOT=/path/to/ndk # if it lives somewhere else\n'
		return 1
	fi
	msg "ok"
}

# --- dispatch -----------------------------------------------------------------------------------------

# every verb except help and update-self: at most one hint on stderr, never a different exit code
case "${1:-help}" in
	help | -h | --help | update-self) ;;
	*) check_self_update || true ;;
esac

case "${1:-help}" in
	doctor) if [ "$MODE" = device ]; then device_doctor; else workstation_doctor; fi ;;
	status) if [ "$MODE" = device ]; then print_status; else device_run status; fi ;;
	verify) if [ "$MODE" = device ]; then run_verify; else device_run verify; fi ;;
	install)
		shift
		reject_option "${1:-}"
		if [ "$MODE" = device ]; then device_install "${1:-}"; else workstation_install "${1:-}"; fi
		;;
	build)
		shift
		reject_option "${1:-}"
		if [ "$MODE" = device ]; then device_build "${1:-}"; else workstation_build "${1:-}"; fi
		;;
	device) shift; cmd_device "${1:-}" ;;
	install-self) cmd_install_self ;;
	update-self) cmd_update_self ;;
	uninstall-self) cmd_uninstall_self ;;
	help | -h | --help) usage ;;
	*) warn "unknown verb: ${1:-}"; usage; exit 1 ;;
esac
